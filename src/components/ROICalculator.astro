---
// Interactive ROI Calculator for Dermatology Practices
---

<section id="roi-calculator" class="section-lg" style="background-color: var(--bg-canvas-soft);">
  <div class="container-main">
    <!-- Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 mb-4">
        <span class="badge-accent">Interactive Calculator</span>
      </div>
      <h2 class="text-ink mb-4" style="font-size: 48px; line-height: 1.15; letter-spacing: -0.96px;">
        Calculate your clinic's ROI.
      </h2>
      <p style="font-size: 16px; font-weight: 300; color: var(--text-ink-mute); max-width: 42rem; margin-inline: auto;">
        See how adding 15–30+ patient consultations transforms your monthly revenue with our tailored 4-Pillar growth engine.
      </p>
    </div>

    <!-- Calculator Card -->
    <div class="max-w-4xl mx-auto card-soft" style="padding: 32px;">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <!-- Controls Column -->
        <div class="lg:col-span-7 space-y-8">
          <!-- Slider 1: Average Patient Ticket Value -->
          <div>
            <div class="flex flex-wrap sm:flex-nowrap justify-between items-center gap-2 mb-3">
              <label for="ticket-slider" style="font-size: 15px; font-weight: 300; color: var(--text-ink);">
                Average Value Per Patient / Procedure
              </label>
              <span id="ticket-val-display" class="money-fig" style="font-size: 15px; font-weight: 400; color: var(--text-ink); padding: 4px 12px; background: var(--bg-canvas); border-radius: 9999px; border: 1px solid var(--border-hairline);">
                ₹4,500
              </span>
            </div>
            <input
              id="ticket-slider"
              type="range"
              min="1000"
              max="25000"
              step="500"
              value="4500"
              class="input-stripe w-full cursor-pointer"
              style="height: 6px; border-radius: 9999px; accent-color: #533afd; padding: 0; border: none;"
            />
            <div class="flex justify-between mt-2" style="font-size: 13px; font-weight: 400; color: var(--text-ink-mute);">
              <span>₹1,000 <span class="hidden sm:inline">(Acne/Derm)</span></span>
              <span>₹10,000 <span class="hidden sm:inline">(PRP/Peels)</span></span>
              <span>₹25,000+ <span class="hidden sm:inline">(Laser)</span></span>
            </div>
          </div>

          <!-- Slider 2: New Patient Consultations Per Month -->
          <div>
            <div class="flex flex-wrap sm:flex-nowrap justify-between items-center gap-2 mb-3">
              <label for="patients-slider" style="font-size: 15px; font-weight: 300; color: var(--text-ink);">
                Target New Patient Consultations / Month
              </label>
              <span id="patients-val-display" class="money-fig" style="font-size: 15px; font-weight: 400; color: var(--text-ink); padding: 4px 12px; background: var(--bg-canvas); border-radius: 9999px; border: 1px solid var(--border-hairline);">
                22 Patients
              </span>
            </div>
            <input
              id="patients-slider"
              type="range"
              min="10"
              max="45"
              step="1"
              value="22"
              class="input-stripe w-full cursor-pointer"
              style="height: 6px; border-radius: 9999px; accent-color: #533afd; padding: 0; border: none;"
            />
            <div class="flex justify-between mt-2" style="font-size: 13px; font-weight: 400; color: var(--text-ink-mute);">
              <span>10 <span class="hidden sm:inline">(Starter)</span></span>
              <span>22 <span class="hidden sm:inline">(Average)</span></span>
              <span>45+ <span class="hidden sm:inline">(Scale)</span></span>
            </div>
          </div>

          <!-- Key Assumptions Note -->
          <div class="card" style="padding: 16px; border-radius: 12px;">
            <p style="font-size: 13px; font-weight: 400; color: var(--text-ink-mute); line-height: 1.5;">
              💡 <strong style="color: var(--text-ink);">Model assumptions:</strong> Tailored agency growth retainer + estimated starter Meta ad spend. Zero hidden fees.
            </p>
          </div>
        </div>

        <!-- Output Column -->
        <div class="lg:col-span-5 card text-center flex flex-col justify-between" style="padding: 32px;">
          <div>
            <span class="eyebrow block mb-2" style="color: var(--text-ink-mute);">
              Projected Monthly Revenue
            </span>
            <div id="projected-revenue" class="money-fig" style="font-size: 32px; font-weight: 300; color: var(--text-ink); letter-spacing: -0.64px; margin-bottom: 4px;">
              ₹99,000
            </div>
            <p style="font-size: 13px; font-weight: 400; color: var(--text-ink-mute); margin-bottom: 24px;">
              from new patient procedures alone
            </p>

            <div style="border-top: 1px solid var(--border-hairline); padding-top: 24px; padding-bottom: 24px;" class="space-y-3 text-left">
              <div class="flex justify-between" style="font-size: 15px;">
                <span style="color: var(--text-ink-mute); font-weight: 300;">Total Cost (Retainer + Ads):</span>
                <span class="money-fig" style="font-weight: 400; color: var(--text-ink);">₹33,500</span>
              </div>
              <div class="flex justify-between" style="font-size: 15px;">
                <span style="color: var(--text-ink-mute); font-weight: 300;">Estimated Net Gain:</span>
                <span id="net-gain" class="money-fig" style="font-weight: 400; color: #533afd;">₹65,500/mo</span>
              </div>
              <div class="flex justify-between" style="border-top: 1px solid var(--border-hairline); padding-top: 12px; font-size: 15px;">
                <span style="font-weight: 400; color: var(--text-ink);">Projected ROI Multiple:</span>
                <span id="roi-multiple" class="money-fig" style="font-size: 26px; font-weight: 300; color: var(--text-ink); letter-spacing: -0.26px;">3.0x</span>
              </div>
            </div>
          </div>

          <a
            id="calc-whatsapp-btn"
            href="https://wa.me/919975568867?text=Hi%20DermaArc%2C%20I%20used%20your%20ROI%20calculator.%20My%20target%20is%2022%20patients%20at%20₹4500%20average%20ticket.%20Let%27s%20discuss%20a%20plan."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary w-full mt-4"
            style="height: 44px; font-size: 16px;"
          >
            Lock In This Growth Target
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupCalculator() {
    const ticketSlider = document.getElementById("ticket-slider") as HTMLInputElement | null;
    const patientsSlider = document.getElementById("patients-slider") as HTMLInputElement | null;
    const ticketValDisplay = document.getElementById("ticket-val-display");
    const patientsValDisplay = document.getElementById("patients-val-display");
    const projectedRevenueEl = document.getElementById("projected-revenue");
    const netGainEl = document.getElementById("net-gain");
    const roiMultipleEl = document.getElementById("roi-multiple");
    const calcWhatsappBtn = document.getElementById("calc-whatsapp-btn") as HTMLAnchorElement | null;

    if (!ticketSlider || !patientsSlider) return;

    const retainerAndAds = 33500;

    function formatINR(val: number): string {
      return "₹" + val.toLocaleString("en-IN");
    }

    function recalculate() {
      const ticket = parseInt(ticketSlider!.value, 10);
      const patients = parseInt(patientsSlider!.value, 10);

      const gross = ticket * patients;
      const net = gross - retainerAndAds;
      const multiple = (gross / retainerAndAds).toFixed(1);

      if (ticketValDisplay) ticketValDisplay.textContent = formatINR(ticket);
      if (patientsValDisplay) patientsValDisplay.textContent = `${patients} Patients`;
      if (projectedRevenueEl) projectedRevenueEl.textContent = formatINR(gross);
      if (netGainEl) netGainEl.textContent = `${formatINR(net)}/mo`;
      if (roiMultipleEl) roiMultipleEl.textContent = `${multiple}x`;

      if (calcWhatsappBtn) {
        const msg = encodeURIComponent(
          `Hi DermaArc, I used your ROI calculator on dermaarc.com. My target is ${patients} patient bookings at an average of ₹${ticket.toLocaleString("en-IN")} per procedure (Projected Revenue: ₹${gross.toLocaleString("en-IN")}). Let's discuss getting started.`
        );
        calcWhatsappBtn.href = `https://wa.me/919975568867?text=${msg}`;
      }
    }

    ticketSlider.addEventListener("input", recalculate);
    patientsSlider.addEventListener("input", recalculate);
    recalculate();
  }

  // Setup on page load
  setupCalculator();
  document.addEventListener("astro:page-load", setupCalculator);
</script>
