---
// Stats Bar — key metrics with Indian context
const stats = [
  { value: "₹14.94", label: "Cost Per Qualified Lead", prefix: "" },
  { value: "61K+", label: "Local Residents Reached", prefix: "" },
  { value: "15–30+", label: "Patient Consultations / Mo", prefix: "" },
  { value: "₹30K", label: "All-Inclusive Monthly Retainer", prefix: "" },
];
---

<section id="stats" class="section bg-canvas-soft">
  <div class="container-main">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-4">
      {stats.map((stat) => (
        <div class="text-center group">
          <div class="font-display font-bold text-ink mb-2" style="font-size: clamp(28px, 3.5vw, 48px); line-height: 1.0;">
            {stat.value}
          </div>
          <p class="text-text-muted font-body text-sm">
            {stat.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
