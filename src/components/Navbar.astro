---
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: "How It Works", href: "/#four-pillars" },
  { label: "Results", href: "/#results" },
  { label: "Pricing", href: "/#pricing" },
  { label: "About", href: "/about" },
  { label: "Blog", href: "/blog" },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div class="flex items-center justify-between w-full max-w-[1200px] mx-auto px-6 py-4">
    <!-- Logo (left) -->
    <a href="/" id="nav-logo" class="flex items-center gap-2.5 shrink-0">
      <img src="/favicon.svg" alt="DermaArc Logo" class="w-8 h-8 rounded-full object-contain" />
      <span
        class="font-display text-lg tracking-tight"
        style="font-weight: 300; color: #0d253d;"
      >DermaArc</span>
    </a>

    <!-- Desktop Links (center) -->
    <nav id="nav-links-desktop" class="hidden lg:flex items-center gap-1 absolute left-1/2 -translate-x-1/2" aria-label="Primary navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "px-4 py-2 text-[15px] font-body rounded-pill transition-colors duration-200",
            currentPath === link.href || currentPath.startsWith(link.href + "/")
              ? "nav-link-active"
              : "nav-link",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA (right): Region Switcher + Filled Indigo Pill -->
    <div class="hidden lg:flex items-center gap-3">
      <!-- Region Selector Dropdown -->
      <div class="relative group">
        <button
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-hairline text-xs font-body text-ink-secondary hover:text-primary transition-colors cursor-pointer"
          aria-label="Select Region"
        >
          <span>🌐</span>
          <span class="font-normal">{currentPath.startsWith('/uk') ? 'UK 🇬🇧' : currentPath.startsWith('/us') ? 'US 🇺🇸' : 'IN 🇮🇳'}</span>
          <svg class="w-3 h-3 text-ink-mute" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute right-0 top-full pt-1 hidden group-hover:block z-50">
          <div class="bg-canvas border border-hairline rounded-lg shadow-lg py-1.5 px-1 min-w-[150px]">
            <a href="/" class="flex items-center gap-2 px-3 py-2 rounded text-xs text-ink hover:bg-canvas-soft transition-colors">
              <span>🇮🇳</span> <span class="font-light">India (Global)</span>
            </a>
            <a href="/uk" class="flex items-center gap-2 px-3 py-2 rounded text-xs text-ink hover:bg-canvas-soft transition-colors">
              <span>🇬🇧</span> <span class="font-light">UK Clinics</span>
            </a>
            <a href="/us" class="flex items-center gap-2 px-3 py-2 rounded text-xs text-ink hover:bg-canvas-soft transition-colors">
              <span>🇺🇸</span> <span class="font-light">US Practices</span>
            </a>
          </div>
        </div>
      </div>

      <a href="/#inquiry-form" class="btn-primary text-sm flex items-center gap-2">
        Get Clinic Audit
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <div class="lg:hidden flex items-center">
      <button
        id="mobile-menu-btn"
        class="flex items-center justify-center w-10 h-10 rounded-lg transition-colors cursor-pointer"
        style="color: #0d253d;"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden w-full overflow-y-auto"
    style="background-color: #ffffff; border-top: 1px solid #e3e8ee; max-height: 80vh;"
  >
    <div class="max-w-[1200px] mx-auto px-6 py-4 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "px-4 py-3 text-base font-body transition-colors duration-200 min-h-[48px] flex items-center rounded-lg",
            currentPath === link.href
              ? "mobile-link-active"
              : "mobile-link",
          ]}
        >
          {link.label}
        </a>
      ))}
      <!-- Region Selector (Mobile) -->
      <div class="mt-2 pt-3 border-t border-hairline">
        <p class="eyebrow text-ink-mute mb-2 px-2">Select Region</p>
        <div class="grid grid-cols-3 gap-2">
          <a
            href="/"
            class:list={[
              "text-center py-2 px-2 rounded-lg text-xs font-body border transition-colors",
              currentPath === "/" ? "bg-canvas-soft border-primary text-primary" : "border-hairline text-ink-secondary"
            ]}
          >
            🇮🇳 India
          </a>
          <a
            href="/uk"
            class:list={[
              "text-center py-2 px-2 rounded-lg text-xs font-body border transition-colors",
              currentPath.startsWith("/uk") ? "bg-canvas-soft border-primary text-primary" : "border-hairline text-ink-secondary"
            ]}
          >
            🇬🇧 UK
          </a>
          <a
            href="/us"
            class:list={[
              "text-center py-2 px-2 rounded-lg text-xs font-body border transition-colors",
              currentPath.startsWith("/us") ? "bg-canvas-soft border-primary text-primary" : "border-hairline text-ink-secondary"
            ]}
          >
            🇺🇸 US
          </a>
        </div>
      </div>

      <div class="mt-2">
        <a href="/#inquiry-form" class="btn-primary w-full text-center min-h-[48px] flex items-center justify-center">
          Request Growth Plan
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Nav-bar-on-mesh: transparent by default, floats over gradient mesh hero */
  #site-header {
    background-color: transparent;
  }

  /* When scrolled, solidify to white canvas with Level 1 shadow */
  #site-header.scrolled {
    background-color: #ffffff;
    box-shadow: rgba(0, 55, 112, 0.08) 0 1px 3px;
    border-bottom: 1px solid #e3e8ee;
  }

  .nav-link {
    font-weight: 300;
    color: #64748d;
  }
  .nav-link:hover {
    color: #0d253d;
  }
  .nav-link-active {
    font-weight: 300;
    color: #0d253d;
  }
  .mobile-link {
    font-weight: 300;
    color: #64748d;
  }
  .mobile-link:hover {
    color: #0d253d;
    background-color: #f6f9fc;
  }
  .mobile-link-active {
    font-weight: 300;
    color: #0d253d;
    background-color: #f6f9fc;
  }
</style>

<script>
  function setupNav() {
    // Mobile Menu
    const menuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("menu-icon-open");
    const iconClose = document.getElementById("menu-icon-close");

    let isOpen = false;

    function closeMenu() {
      isOpen = false;
      mobileMenu?.classList.add("hidden");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      menuBtn?.setAttribute("aria-expanded", "false");
    }

    menuBtn?.addEventListener("click", () => {
      isOpen = !isOpen;
      mobileMenu?.classList.toggle("hidden", !isOpen);
      iconOpen?.classList.toggle("hidden", isOpen);
      iconClose?.classList.toggle("hidden", !isOpen);
      menuBtn?.setAttribute("aria-expanded", String(isOpen));
    });

    // Close menu when clicking outside
    document.addEventListener("click", (e) => {
      if (isOpen && !menuBtn?.contains(e.target as Node) && !mobileMenu?.contains(e.target as Node)) {
        closeMenu();
      }
    });

    // Close menu when clicking any nav anchor link inside it
    mobileMenu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });

    // Scroll: transparent → solid white with shadow
    const header = document.getElementById("site-header");
    function handleScroll() {
      if (window.scrollY > 40) {
        header?.classList.add("scrolled");
      } else {
        header?.classList.remove("scrolled");
      }
    }
    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();
  }

  setupNav();
  document.addEventListener("astro:page-load", setupNav);
</script>
