---
// Services Grid — core offerings
const services = [
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>`,
    title: "Search Engine Optimization.",
    description: "Dominate organic search results with technical SEO, content strategy, and authority building that compounds over time.",
    link: "/services#seo",
    features: ["Technical Audits", "Keyword Strategy", "Link Building", "Local SEO"],
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/></svg>`,
    title: "PPC & Paid Media.",
    description: "Precision-targeted advertising across Google, Meta, and LinkedIn that maximizes every dollar of your ad spend.",
    link: "/services#ppc",
    features: ["Google Ads", "Meta Ads", "LinkedIn Ads", "Retargeting"],
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/></svg>`,
    title: "Social Media Marketing.",
    description: "Build authentic communities and drive engagement with strategic content, influencer partnerships, and paid social campaigns.",
    link: "/services#social",
    features: ["Content Strategy", "Community Management", "Influencer Outreach", "Paid Social"],
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>`,
    title: "Content Marketing.",
    description: "Thought-leadership content that positions your brand as the authority. Blog posts, whitepapers, video, and more.",
    link: "/services#content",
    features: ["Blog Strategy", "Video Production", "Whitepapers", "Email Sequences"],
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
    title: "Web Design & Development.",
    description: "Conversion-optimized websites that look stunning and perform even better. Built for speed, SEO, and user experience.",
    link: "/services#web-design",
    features: ["UI/UX Design", "CRO", "Speed Optimization", "A/B Testing"],
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
    title: "Email Marketing.",
    description: "Nurture leads and retain customers with automated email sequences, newsletters, and lifecycle campaigns.",
    link: "/services#email",
    features: ["Automation", "Segmentation", "A/B Testing", "Analytics"],
  },
];
---

<section id="services" class="section-lg">
  <div class="container-main">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <p class="text-text-muted font-body text-sm font-semibold uppercase tracking-wide mb-4">What we do</p>
      <h2 class="font-display font-bold text-ink mb-4">
        Full-spectrum digital growth.
      </h2>
      <p class="text-text-muted font-body text-lg font-light max-w-2xl mx-auto">
        Every service engineered to work together. No silos, no fragmented strategies — just integrated marketing that compounds results.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service, i) => (
        <a
          href={service.link}
          class="card group hover:bg-canvas-soft transition-all duration-300 hover:-translate-y-1"
        >
          <!-- Icon -->
          <div class="w-12 h-12 rounded-full bg-canvas-soft group-hover:bg-canvas flex items-center justify-center mb-6 transition-colors duration-300">
            <Fragment set:html={service.icon} />
          </div>

          <!-- Title -->
          <h3 class="font-display text-xl font-bold text-ink mb-3">
            {service.title}
          </h3>

          <!-- Description -->
          <p class="text-text-muted font-body text-sm leading-relaxed mb-6">
            {service.description}
          </p>

          <!-- Features -->
          <div class="flex flex-wrap gap-2">
            {service.features.map((feature) => (
              <span class="inline-flex items-center h-7 px-3 rounded-full bg-canvas-soft text-text-muted text-xs font-semibold font-body">
                {feature}
              </span>
            ))}
          </div>

          <!-- Arrow -->
          <div class="mt-6 flex items-center gap-2 text-text-muted group-hover:text-ink transition-colors duration-200">
            <span class="text-sm font-semibold font-body">Learn more</span>
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
