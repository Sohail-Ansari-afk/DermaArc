---
// Services Grid — Core offerings
// Redesigned to Stripe DESIGN.md: card-feature-light on canvas-soft,
// Inter weight 300 typography, primary link-on-light, badge-accent chips.

const services = [
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>`,
    title: "Search Engine Optimization.",
    description: "Dominate organic search results with technical SEO, content strategy, and authority building that compounds over time.",
    link: "/services#google-maps",
    features: ["Technical Audits", "Keyword Strategy", "Link Building", "Local SEO"],
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/></svg>`,
    title: "PPC & Paid Media.",
    description: "Precision-targeted advertising across Google, Meta, and Instagram that maximizes every rupee of your ad spend.",
    link: "/services#meta-ads",
    features: ["Google Ads", "Meta Ads", "Instagram Reels", "Retargeting"],
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/></svg>`,
    title: "Social Media Marketing.",
    description: "Build authentic communities and drive consultation bookings with strategic clinical content and NMC-compliant Reels.",
    link: "/services#instagram",
    features: ["Content Strategy", "Doctor Branding", "90-Min Recording", "Paid Social"],
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>`,
    title: "Content Marketing.",
    description: "Thought-leadership content that positions the doctor as the local authority. Treatment guides, clinical carousels, and patient education.",
    link: "/services#instagram",
    features: ["Blog Strategy", "Video Production", "Patient Guides", "WhatsApp Sequences"],
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
    title: "Web Design & Development.",
    description: "Conversion-optimized procedure landing pages that load in under 2 seconds. Built for speed, mobile patients, and 1-tap WhatsApp booking.",
    link: "/services#websites",
    features: ["Sub-2s Speed", "1-Tap WhatsApp", "Mobile-First", "CRO Architecture"],
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
    title: "Patient Retention & CRM.",
    description: "Eliminate lead ghosting on WhatsApp with automated follow-up sequences and front-desk instant notifications.",
    link: "/services#meta-ads",
    features: ["Instant Alerts", "5-Min Response", "WhatsApp CRM", "Review QR Stands"],
  },
];
---

<section id="services" class="section-lg bg-canvas-soft border-t border-hairline">
  <div class="container-main">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <p class="eyebrow text-ink-mute mb-3">Specialized Capabilities</p>
      <h2 class="font-display font-light text-ink mb-4" style="font-size: clamp(30px, 4vw, 48px); letter-spacing: -0.96px; line-height: 1.15; text-wrap: balance;">
        Full-spectrum clinical growth.
      </h2>
      <p class="text-ink-mute font-body font-light text-base max-w-2xl mx-auto leading-relaxed">
        Every service engineered to work together. No silos, no fragmented strategies — just an integrated patient booking engine that compounds monthly.
      </p>
    </div>

    <!-- Grid: 3-Up on Desktop, 2-Up on Tablet, 1-Up on Mobile -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service) => (
        <a
          href={service.link}
          class="card group flex flex-col justify-between"
        >
          <div>
            <!-- Icon -->
            <div class="w-12 h-12 rounded-lg bg-canvas-soft flex items-center justify-center mb-6 text-primary border border-hairline group-hover:border-primary transition-colors duration-200">
              <Fragment set:html={service.icon} />
            </div>

            <!-- Title: heading-md (20px, weight 300, -0.2px) -->
            <h3 class="font-display font-light text-ink text-xl mb-3" style="letter-spacing: -0.2px;">
              {service.title}
            </h3>

            <!-- Description: body-md (15px, weight 300) -->
            <p class="text-ink-secondary font-body font-light text-[15px] leading-relaxed mb-6">
              {service.description}
            </p>
          </div>

          <div>
            <!-- Features Chips -->
            <div class="flex flex-wrap gap-2 mb-6">
              {service.features.map((feature) => (
                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-canvas-soft border border-hairline text-ink-mute text-xs font-light">
                  {feature}
                </span>
              ))}
            </div>

            <!-- Learn More Arrow: link-on-light -->
            <div class="pt-4 border-t border-hairline flex items-center gap-1.5 text-primary text-sm font-normal group-hover:text-primary-deep transition-colors">
              <span>Explore pillar</span>
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
