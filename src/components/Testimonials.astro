---
// Testimonials — Dermatologist Case Stories
// Follows Stripe DESIGN.md: cards live on near-white surfaces (card-feature-light),
// 12px radius, 32px padding, Level 1 shadow, Sohne/Inter weight 300 typography.

const testimonials = [
  {
    quote: "Before DermaArc, I was paying three different freelancers and getting zero accountability. Now everything is under one roof — my WhatsApp inquiries have tripled and I know exactly what every rupee is doing.",
    name: "Dr. Meera Kulkarni",
    role: "Dermatologist",
    company: "SkinFirst Clinic, Pune",
  },
  {
    quote: "The Instagram content calendar was a game-changer. I batch-record all my Reels in 90 minutes on a Sunday and DermaArc handles everything else. My clinic's Instagram went from 200 to 4,000 followers in four months.",
    name: "Dr. Rajesh Nair",
    role: "Cosmetic Dermatologist",
    company: "Radiance Aesthetics, Mumbai",
  },
  {
    quote: "I was sceptical about digital marketing — I'd been burned by agencies before. DermaArc's transparent reporting changed my mind. I see total inquiries, cost per lead, and walk-ins. Nothing is hidden.",
    name: "Dr. Ananya Sharma",
    role: "Trichologist",
    company: "HairCare Studio, Bangalore",
  },
  {
    quote: "We went from 8 walk-ins a week to consistently 25+. The Google Maps optimisation alone was worth the entire retainer — we now rank in the top 3 for every 'dermatologist near me' search in our area.",
    name: "Dr. Vikram Desai",
    role: "Dermatologist & Laser Specialist",
    company: "DermaCare Clinic, Hyderabad",
  },
];
---

<section id="testimonials" class="section-lg bg-canvas-soft border-t border-hairline">
  <div class="container-main">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <p class="eyebrow text-ink-mute mb-3">Doctor stories</p>
      <h2 class="font-display font-light text-ink mb-4" style="font-size: clamp(28px, 4vw, 48px); letter-spacing: -0.96px; line-height: 1.15; text-wrap: balance;">
        What dermatologists say.
      </h2>
      <p class="text-ink-mute font-body font-light text-base max-w-xl mx-auto leading-relaxed">
        Real outcomes from skin clinics, laser centers, and aesthetic practices across India.
      </p>
    </div>

    <!-- Testimonial Cards: 2-Column Grid on Desktop -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {testimonials.map((testimonial) => (
        <div class="card flex flex-col justify-between">
          <!-- Quote -->
          <p class="text-ink-secondary font-body font-light text-base leading-relaxed mb-8">
            "{testimonial.quote}"
          </p>

          <!-- Author Info -->
          <div class="flex items-center gap-3.5 pt-4 border-t border-hairline">
            <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0" style="background-color: #f6f9fc; border: 1px solid #e3e8ee;">
              <span class="text-primary font-display font-medium text-sm">
                {testimonial.name.split(' ').pop()?.charAt(0)}
              </span>
            </div>
            <div>
              <p class="text-ink font-display font-light text-base" style="letter-spacing: 0;">
                {testimonial.name}
              </p>
              <p class="text-ink-mute font-body text-xs font-light">
                {testimonial.role} · <span class="text-ink-secondary">{testimonial.company}</span>
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
