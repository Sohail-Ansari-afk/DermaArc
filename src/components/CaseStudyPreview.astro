---
// Case Study Preview — Verified results from Indian dermatology clinics
const caseStudies = [
  {
    client: "Skin & Hair Clinic",
    city: "Pune",
    metric: "₹14.94",
    metricLabel: "Cost Per Lead",
    description: "Hyper-local Meta ads targeting a 5 km radius generated qualified WhatsApp inquiries at under ₹15 per lead — on a starter budget of just ₹150/day.",
    services: ["Meta Ads", "WhatsApp Booking"],
  },
  {
    client: "Aesthetic Laser Centre",
    city: "Mumbai",
    metric: "61,075",
    metricLabel: "Local Residents Reached",
    description: "Reached over 61,000 local residents for just ₹145.99 total (₹2.39 per 1,000 reached), filling appointment slots for laser hair reduction and HydraFacials.",
    services: ["Local Reach", "GMB Optimisation"],
  },
  {
    client: "Hair PRP Studio",
    city: "Bangalore",
    metric: "27+",
    metricLabel: "Consultations / Month",
    description: "Combined Instagram authority content with Google Maps optimisation to drive 27+ monthly consultations for PRP therapy — up from 8 walk-ins before DermaArc.",
    services: ["Instagram Content", "Google Maps"],
  },
];
---

<section id="results" class="section-lg">
  <div class="container-main">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12">
      <div>
        <p class="text-text-muted font-body text-sm font-semibold uppercase tracking-wide mb-4">Verified results</p>
        <h2 class="font-display font-bold text-ink">
          Proof, not promises.
        </h2>
      </div>
      <p class="text-text-muted font-body text-sm max-w-sm mt-4 md:mt-0">
        Real metrics from real dermatology clinics. Every number verified. Zero vanity metrics.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {caseStudies.map((study) => (
        <div class="card group hover:-translate-y-1 transition-all duration-300">
          <!-- Result Preview -->
          <div class="bg-canvas-soft rounded-[16px] p-5 sm:p-8 mb-6 text-center">
            <div class="font-display font-bold text-ink mb-1" style="font-size: clamp(34px, 4.5vw, 48px); line-height: 1.0;">
              {study.metric}
            </div>
            <p class="text-text-muted font-body text-sm">{study.metricLabel}</p>
          </div>

          <!-- Client Info -->
          <div class="mb-3 flex items-center gap-2">
            <div class="w-6 h-6 rounded-[30%] bg-canvas-soft flex items-center justify-center shrink-0">
              <span class="text-ink text-[10px] font-bold font-display">{study.client.charAt(0)}</span>
            </div>
            <span class="font-body text-sm font-semibold text-ink">{study.client}</span>
            <span class="text-text-faint text-xs">· {study.city}</span>
          </div>

          <!-- Description -->
          <p class="text-text-muted font-body text-sm leading-relaxed mb-4">
            {study.description}
          </p>

          <!-- Service Tags -->
          <div class="flex flex-wrap gap-2">
            {study.services.map((service) => (
              <span class="inline-flex items-center h-6 px-3 rounded-full bg-canvas-soft text-text-muted text-xs font-semibold font-body">
                {service}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
