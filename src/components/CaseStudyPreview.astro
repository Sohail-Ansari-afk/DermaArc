---
// Case Study Preview — Verified results from Indian dermatology clinics
// Cream-band interlude with tabular-figure metrics
const caseStudies = [
  {
    client: "Skin & Hair Clinic",
    city: "Pune",
    metric: "₹14.94",
    metricLabel: "Cost Per Lead",
    description: "Hyper-local Meta ads targeting a 5 km radius generated qualified WhatsApp inquiries at under ₹15 per lead — on a starter budget of just ₹150/day.",
    services: ["Meta Ads", "WhatsApp Booking"],
  },
  {
    client: "Aesthetic Laser Centre",
    city: "Mumbai",
    metric: "61,075",
    metricLabel: "Local Residents Reached",
    description: "Reached over 61,000 local residents for just ₹145.99 total (₹2.39 per 1,000 reached), filling appointment slots for laser hair reduction and HydraFacials.",
    services: ["Local Reach", "GMB Optimisation"],
  },
  {
    client: "Hair PRP Studio",
    city: "Bangalore",
    metric: "27+",
    metricLabel: "Consultations / Month",
    description: "Combined Instagram authority content with Google Maps optimisation to drive 27+ monthly consultations for PRP therapy — up from 8 walk-ins before DermaArc.",
    services: ["Instagram Content", "Google Maps"],
  },
];
---

<section id="results" class="section" style="background-color:#f5e9d4;">
  <div class="container-main">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12">
      <div>
        <span class="badge-accent mb-4 inline-block">Verified results</span>
        <h2 class="text-ink">
          Proof, not promises.
        </h2>
      </div>
      <p class="text-[15px] text-ink-mute max-w-sm mt-4 md:mt-0" style="line-height:1.4;">
        Real metrics from real dermatology clinics. Every number verified. Zero vanity metrics.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {caseStudies.map((study) => (
        <div class="card group hover:-translate-y-0.5 transition-all duration-200">
          <!-- Metric Display -->
          <div class="mb-6 pb-6" style="border-bottom:1px solid #e3e8ee;">
            <div
              class="text-ink mb-1"
              style="font-size:26px; font-weight:300; letter-spacing:-0.26px; line-height:1.12; font-feature-settings:'tnum';"
            >
              {study.metric}
            </div>
            <p
              class="text-ink-mute"
              style="font-size:13px; font-weight:400; letter-spacing:-0.39px; line-height:1.4;"
            >
              {study.metricLabel}
            </p>
          </div>

          <!-- Client Info -->
          <div class="mb-3 flex items-center gap-2">
            <div
              class="w-6 h-6 rounded-full flex items-center justify-center shrink-0"
              style="background-color:#b9b9f9;"
            >
              <span class="text-[10px] font-normal" style="color:#4434d4;">
                {study.client.charAt(0)}
              </span>
            </div>
            <span class="text-[15px] text-ink" style="font-weight:300;">
              {study.client}
            </span>
            <span class="text-ink-mute text-[13px]" style="letter-spacing:-0.39px;">
              · {study.city}
            </span>
          </div>

          <!-- Description -->
          <p class="text-[15px] text-ink-mute mb-5" style="line-height:1.4;">
            {study.description}
          </p>

          <!-- Service Tags -->
          <div class="flex flex-wrap gap-2">
            {study.services.map((service) => (
              <span class="badge-accent">
                {service}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a href="#inquiry-form" class="btn-outline">
        See all case studies →
      </a>
    </div>
  </div>
</section>
