---
// Process Section — How the engagement works
// Step-by-step timeline with badge-accent number badges
const steps = [
  {
    number: "01",
    title: "Free Strategy Call.",
    description: "A 20-minute WhatsApp or Zoom call where we audit your current online presence, identify the biggest gaps, and map out a custom growth plan for your clinic.",
  },
  {
    number: "02",
    title: "4-Pillar Setup.",
    description: "We build your conversion-first website, set up Meta ad campaigns, optimise your Google Business Profile, and create your first month's Instagram content calendar — all within 7–10 days.",
  },
  {
    number: "03",
    title: "Launch & Fill Slots.",
    description: "Campaigns go live. WhatsApp leads start flowing. Walk-ins increase. Your front desk gets real-time alerts for every inquiry so no lead slips through the cracks.",
  },
  {
    number: "04",
    title: "Report & Optimise.",
    description: "Monthly reports tracking only what matters — total inquiries, cost per lead, and clinic walk-ins. No vanity metrics. We optimise relentlessly to reduce CPL and increase bookings.",
  },
];
---

<section id="process" class="section bg-canvas-soft">
  <div class="container-main">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="badge-accent mb-4 inline-block">How it works</span>
      <h2 class="text-ink mb-4">
        Live in 10 days.<br class="hidden sm:block" />
        Results in 30.
      </h2>
      <p class="text-[15px] text-ink-mute max-w-2xl mx-auto" style="line-height:1.4;">
        No month-long onboarding. No drawn-out discovery phases. Your 4-Pillar System goes live within 10 days of signing.
      </p>
    </div>

    <!-- Steps Timeline -->
    <div class="relative max-w-4xl mx-auto">
      <!-- Vertical timeline connector (desktop) -->
      <div
        class="hidden md:block absolute left-6 top-0 bottom-0 w-px"
        style="background: linear-gradient(180deg, #b9b9f9 0%, #e3e8ee 100%);"
      ></div>

      <div class="grid grid-cols-1 gap-6">
        {steps.map((step, i) => (
          <div class="relative flex gap-6 md:gap-8">
            <!-- Number Badge + Connector Dot -->
            <div class="flex flex-col items-center shrink-0 z-10">
              <span class="badge-accent">
                {step.number}
              </span>
              {i < steps.length - 1 && (
                <div class="hidden md:block w-px flex-1 mt-2 bg-hairline"></div>
              )}
            </div>

            <!-- Step Card -->
            <div class="card flex-1 group hover:-translate-y-0.5 transition-all duration-200">
              <h6 class="text-ink mb-2">
                {step.title}
              </h6>
              <p class="text-[15px] text-ink-mute" style="line-height:1.4;">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
