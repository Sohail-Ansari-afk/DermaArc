---
// CTA & Clinic Growth Application Section with Web3Forms Integration
// Form Key: 5335ef61-bcd9-4e43-ae81-932d76b7f9e1
// Redesigned to Stripe DESIGN.md: stripe-mesh atmospheric backdrop,
// card with Level 2 shadow, input-stripe form inputs, pill CTA.
---

<section id="inquiry-form" class="stripe-mesh section-lg bg-canvas relative overflow-hidden border-t border-hairline">
  <div class="container-main relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start max-w-6xl mx-auto">
      
      <!-- Left Column: Value Proposition & Next Steps -->
      <div class="lg:col-span-5 space-y-8">
        <div>
          <span class="badge-accent mb-4 inline-block">Clinic Application</span>
          <h2 class="font-display font-light text-ink mb-4" style="font-size: clamp(32px, 4.5vw, 48px); letter-spacing: -1.2px; line-height: 1.08; text-wrap: balance;">
            Stop losing patients<br />
            <span class="gradient-text">to med spas.</span>
          </h2>
          <p class="font-body font-light text-ink-mute text-base sm:text-lg leading-relaxed">
            Fill in your clinic details below. Sohail will personally audit your local market, competitor landscape, and patient acquisition gaps — delivering a custom growth roadmap within 24 hours.
          </p>
        </div>

        <!-- What Happens Next Process -->
        <div class="space-y-4 pt-6 border-t border-hairline">
          <h3 class="font-display font-light text-ink text-lg" style="letter-spacing: -0.2px;">
            What happens after you apply:
          </h3>
          
          <div class="flex items-start gap-3.5">
            <div class="w-7 h-7 rounded-full bg-canvas border border-hairline flex items-center justify-center shrink-0 font-display text-xs text-primary font-medium money-fig">
              1
            </div>
            <div>
              <p class="font-display font-light text-ink text-sm">Competitor &amp; Local Maps Audit</p>
              <p class="font-body font-light text-ink-mute text-xs leading-relaxed mt-0.5">
                We analyze the 5–10 km radius around your clinic, your Google Maps rank, and med spa ad spend in your area.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3.5">
            <div class="w-7 h-7 rounded-full bg-canvas border border-hairline flex items-center justify-center shrink-0 font-display text-xs text-primary font-medium money-fig">
              2
            </div>
            <div>
              <p class="font-display font-light text-ink text-sm">Custom 4-Pillar Roadmap</p>
              <p class="font-body font-light text-ink-mute text-xs leading-relaxed mt-0.5">
                You get tailored projections: estimated cost-per-lead, monthly consultation targets, and procedure funnel design.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3.5">
            <div class="w-7 h-7 rounded-full bg-canvas border border-hairline flex items-center justify-center shrink-0 font-display text-xs text-primary font-medium money-fig">
              3
            </div>
            <div>
              <p class="font-display font-light text-ink text-sm">Direct Founder Communication</p>
              <p class="font-body font-light text-ink-mute text-xs leading-relaxed mt-0.5">
                Sohail connects with you directly on WhatsApp or phone. No junior sales reps, zero hard pressure.
              </p>
            </div>
          </div>
        </div>

        <!-- Trust Badges -->
        <div class="p-5 rounded-lg bg-canvas-soft border border-hairline space-y-2.5 font-body text-xs text-ink-secondary">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-primary shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Tailored clinic retainer · Zero hidden agency markups</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-primary shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>100% compliant with NMC medical advertising guidelines</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-primary shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>No lock-in contract · Results delivered in 30 days</span>
          </div>
        </div>

        <!-- Alternate Direct WhatsApp Link -->
        <p class="font-body text-xs text-ink-mute">
          Prefer an immediate response?{" "}
          <a
            href="https://wa.me/919975568867?text=Hi%20DermaArc%2C%20I%27d%20like%20to%20discuss%20a%20growth%20plan%20for%20my%20clinic."
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary hover:text-primary-deep transition-colors"
          >
            Chat directly with Sohail on WhatsApp (+91 99755 68867) →
          </a>
        </p>
      </div>

      <!-- Right Column: Interactive Web3Forms Form Card (White on Canvas, Level 2 Shadow) -->
      <div class="lg:col-span-7">
        <div class="card p-6 sm:p-10 relative" style="box-shadow: rgba(0,55,112,0.08) 0 8px 24px, rgba(0,55,112,0.04) 0 2px 6px;">
          
          <!-- Success State Message (Hidden by default, shown via JS) -->
          <div id="form-success-message" class="hidden text-center py-12 space-y-4">
            <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-2" style="background-color: #b9b9f9; color: #4434d4;">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="font-display font-light text-ink text-2xl sm:text-3xl" style="letter-spacing: -0.64px;">
              Application Received!
            </h3>
            <p class="font-body font-light text-ink-secondary text-sm sm:text-base max-w-md mx-auto leading-relaxed">
              Thank you for submitting your clinic details. Sohail is reviewing your online presence and local competition. We will reach out to you via WhatsApp / email within 24 hours.
            </p>
            <div class="pt-4">
              <a
                href="https://wa.me/919975568867?text=Hi%20DermaArc%2C%20I%20just%20submitted%20the%20clinic%20application%20form%20on%20your%20website."
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary inline-flex text-sm"
              >
                Open WhatsApp for Faster Reply →
              </a>
            </div>
          </div>

          <!-- The Form -->
          <form
            id="clinic-inquiry-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-5"
          >
            <!-- Web3Forms Access Key & Configuration -->
            <input type="hidden" name="access_key" value="5335ef61-bcd9-4e43-ae81-932d76b7f9e1" />
            <input type="hidden" name="subject" value="New Dermatology Patient Acquisition Inquiry — DermaArc" />
            <input type="hidden" name="from_name" value="DermaArc Clinic Inquiries" />
            <!-- Honeypot Spam Protection -->
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

            <div class="border-b border-hairline pb-4 mb-2">
              <h3 class="font-display font-light text-ink text-xl" style="letter-spacing: -0.2px;">
                Request Your Clinic Growth Plan
              </h3>
              <p class="font-body font-light text-ink-mute text-xs mt-1">
                Zero spam. Your information is kept strictly confidential.
              </p>
            </div>

            <!-- Doctor Name & Clinic Name Row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="doctor-name" class="block eyebrow text-ink mb-2">
                  Doctor / Founder Name <span class="text-stripe-ruby">*</span>
                </label>
                <input
                  type="text"
                  id="doctor-name"
                  name="name"
                  required
                  placeholder="e.g., Dr. Ananya Deshmukh"
                  class="input-stripe"
                />
              </div>

              <div>
                <label for="clinic-name" class="block eyebrow text-ink mb-2">
                  Clinic Name <span class="text-stripe-ruby">*</span>
                </label>
                <input
                  type="text"
                  id="clinic-name"
                  name="clinic_name"
                  required
                  placeholder="e.g., Radiance Skin &amp; Laser"
                  class="input-stripe"
                />
              </div>
            </div>

            <!-- Phone (WhatsApp) & Email Row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="doctor-phone" class="block eyebrow text-ink mb-2">
                  WhatsApp / Phone <span class="text-stripe-ruby">*</span>
                </label>
                <input
                  type="tel"
                  id="doctor-phone"
                  name="phone"
                  required
                  placeholder="+91 98765 43210"
                  class="input-stripe"
                />
              </div>

              <div>
                <label for="doctor-email" class="block eyebrow text-ink mb-2">
                  Email Address <span class="text-stripe-ruby">*</span>
                </label>
                <input
                  type="email"
                  id="doctor-email"
                  name="email"
                  required
                  placeholder="doctor@clinic.com"
                  class="input-stripe"
                />
              </div>
            </div>

            <!-- City & Primary Specialty Row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="clinic-city" class="block eyebrow text-ink mb-2">
                  City &amp; Locality <span class="text-stripe-ruby">*</span>
                </label>
                <input
                  type="text"
                  id="clinic-city"
                  name="city"
                  required
                  placeholder="e.g., Pune (Koregaon Park / Baner)"
                  class="input-stripe"
                />
              </div>

              <div>
                <label for="clinic-type" class="block eyebrow text-ink mb-2">
                  Primary Clinic Focus <span class="text-stripe-ruby">*</span>
                </label>
                <select
                  id="clinic-type"
                  name="clinic_type"
                  required
                  class="input-stripe"
                  style="padding-block: 6px;"
                >
                  <option value="Cosmetic & Laser Clinic">Cosmetic &amp; Laser (Acne scars, peels, laser hair)</option>
                  <option value="Clinical Dermatology Practice">Clinical Dermatology (Acne, eczema, psoriasis)</option>
                  <option value="Hair Restoration & PRP Studio">Hair Restoration &amp; PRP/GFC Therapy</option>
                  <option value="Full Comprehensive Aesthetic Clinic">Comprehensive Skin, Hair &amp; Aesthetics</option>
                </select>
              </div>
            </div>

            <!-- Message / Target Consultation Goal -->
            <div>
              <label for="clinic-message" class="block eyebrow text-ink mb-2">
                What is your biggest growth goal or challenge right now?
              </label>
              <textarea
                id="clinic-message"
                name="message"
                rows="3"
                placeholder="e.g., We get good walk-ins but want to scale HydraFacials, Acne Scar Subcision, and Laser appointments. Competitor med spas are outspending us."
                class="w-full p-3 rounded-[6px] bg-canvas border border-hairline-input text-ink placeholder:text-ink-mute/70 text-[15px] font-light focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all resize-none"
              ></textarea>
            </div>

            <!-- Submit Button (Pill Dominant CTA) -->
            <div>
              <button
                type="submit"
                id="form-submit-btn"
                class="btn-primary w-full cursor-pointer flex items-center justify-center gap-2"
              >
                <span id="btn-text">Submit Application &amp; Get Audit →</span>
                <svg id="btn-spinner" class="w-5 h-5 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </button>
              <p class="text-ink-mute font-body text-[11px] text-center mt-3 font-light">
                🔒 100% Privacy guaranteed · We never share doctor contact details
              </p>
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function setupInquiryForm() {
    const form = document.getElementById("clinic-inquiry-form") as HTMLFormElement | null;
    const successCard = document.getElementById("form-success-message");
    const submitBtn = document.getElementById("form-submit-btn") as HTMLButtonElement | null;
    const btnText = document.getElementById("btn-text");
    const btnSpinner = document.getElementById("btn-spinner");

    if (!form || form.dataset.listenerAttached) return;
    form.dataset.listenerAttached = "true";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = "Submitting your application...";
      if (btnSpinner) btnSpinner.classList.remove("hidden");

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json();

        if (result.success) {
          form.classList.add("hidden");
          successCard?.classList.remove("hidden");
          successCard?.scrollIntoView({ behavior: "smooth", block: "center" });

          // Send Google Analytics conversion event
          if (typeof (window as any).gtag === "function") {
            (window as any).gtag("event", "generate_lead", {
              event_category: "Clinic Application",
              event_label: "Clinic Growth Plan Submission",
              value: 30000,
              currency: "INR",
            });
          }
        } else {
          alert("Submission could not be completed: " + (result.message || "Please check your details or connect via WhatsApp."));
          if (submitBtn) submitBtn.disabled = false;
          if (btnText) btnText.textContent = "Submit Application & Get Audit →";
          if (btnSpinner) btnSpinner.classList.add("hidden");
        }
      } catch (err) {
        form.submit();
      }
    });
  }

  setupInquiryForm();
  document.addEventListener("astro:page-load", setupInquiryForm);
</script>
