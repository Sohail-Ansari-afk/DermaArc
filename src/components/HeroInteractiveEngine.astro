            <div id="label1" class="text-xs sm:text-sm font-semibold text-white/90 mt-1 truncate">
              Mobile-First Speed
            </div>
            <div id="sub1" class="text-[11px] text-white/50 hidden sm:block truncate mt-0.5">
              53% lower bounce
            </div>
          </div>

          <!-- Column 2 (Border Left) -->
          <div class="px-2 sm:px-4 border-l border-white/10">
            <div id="stat2" class="font-display font-bold text-white text-lg sm:text-2xl md:text-3xl tracking-tight transition-transform duration-200">
              Top 3
            </div>
            <div id="label2" class="text-xs sm:text-sm font-semibold text-white/90 mt-1 truncate">
              Google Maps Rank
            </div>
            <div id="sub2" class="text-[11px] text-white/50 hidden sm:block truncate mt-0.5">
              High-intent OPD leads
            </div>
          </div>

          <!-- Column 3 (Border Left) -->
          <div class="px-2 sm:px-4 border-l border-white/10">
            <div id="stat3" class="font-display font-bold text-accent-teal text-lg sm:text-2xl md:text-3xl tracking-tight transition-transform duration-200">
              18–25
            </div>
            <div id="label3" class="text-xs sm:text-sm font-semibold text-white/90 mt-1 truncate">
              Patients / Mo
            </div>
            <div id="sub3" class="text-[11px] text-white/50 hidden sm:block truncate mt-0.5">
              Verified consultations
            </div>
          </div>
        </div>
