  <!-- Mobile / Quick Selector Tabs Bar (Displays below stage for easy mobile tap) -->
  <div class="flex items-center justify-center gap-2 mt-4 max-w-lg mx-auto px-4 overflow-x-auto no-scrollbar">
    {verticals.map((v, i) => (
      <button
        type="button"
        class={`engine-tab-btn px-3 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 border whitespace-nowrap ${
          i === 0 
            ? "bg-neutral-900 text-white border-neutral-900 dark:bg-white dark:text-black dark:border-white shadow-sm" 
            : "bg-white/60 dark:bg-white/5 text-neutral-600 dark:text-neutral-400 border-neutral-200 dark:border-white/10 hover:bg-neutral-100 dark:hover:bg-white/10"
        }`}
        data-target={v.id}
      >
        {v.category.split(" ")[0]}
      </button>
    ))}
  </div>
  <p class="text-center text-text-faint text-xs font-body mt-3">
    Interactive 3D Preview · Move mouse to tilt · Click cards to explore clinic engines
  </p>
</div>

<script>
  // Interactive 3D Parallax Tilt & Clinic Vertical Switching Logic
  document.addEventListener("DOMContentLoaded", () => {
    const stage = document.getElementById("heroInteractiveStage");
    const tiltRig = document.getElementById("tiltRig");
    const satelliteCards = document.querySelectorAll<HTMLElement>(".satellite-card");
    const tabBtns = document.querySelectorAll<HTMLButtonElement>(".engine-tab-btn");

    // Center engine dynamic elements
    const activeModeLabel = document.getElementById("activeModeLabel");
    const engineEyebrow = document.getElementById("engineEyebrow");
    const engineEyebrowText = document.getElementById("engineEyebrowText");
    const engineHeadline = document.getElementById("engineHeadline");
    const engineDescription = document.getElementById("engineDescription");
    const stat1 = document.getElementById("stat1");
    const label1 = document.getElementById("label1");
    const sub1 = document.getElementById("sub1");
    const stat2 = document.getElementById("stat2");
    const label2 = document.getElementById("label2");
    const sub2 = document.getElementById("sub2");
    const stat3 = document.getElementById("stat3");
    const label3 = document.getElementById("label3");
    const sub3 = document.getElementById("sub3");

    // Clinic verticals data dictionary
    const verticalData: Record<string, {
      category: string;
      eyebrow: string;
      eyebrowBadgeStyle: string;
      headline: string;
      description: string;
      stat1: string;
