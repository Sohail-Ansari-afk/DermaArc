    }> = {
      clinical: {
        category: "ENGINE: CLINICAL V2.4",
        eyebrow: "Specialized Clinical Acquisition Engine",
        eyebrowBadgeStyle: "bg-accent-teal/15 text-accent-teal border-accent-teal/30",
        headline: "High-Speed Patient Acquisition Engine",
        description: "Sub-2s procedure pages, hyper-local Meta campaigns, and automated WhatsApp appointment routing engineered exclusively for skin & aesthetic clinics.",
        stat1: "Sub-2s",
        label1: "Mobile-First Speed",
        sub1: "53% lower bounce",
        stat2: "Top 3",
        label2: "Google Maps Rank",
        sub2: "High-intent OPD leads",
        stat3: "18–25",
        label3: "Patients / Clinic / Mo",
        sub3: "Verified consultations",
        stat3Color: "text-accent-teal"
      },
      cosmetic: {
        category: "ENGINE: COSMETIC & LASER",
        eyebrow: "High-Ticket Aesthetic Booking Engine",
        eyebrowBadgeStyle: "bg-accent-gold/15 text-accent-gold border-accent-gold/30",
        headline: "High-Ticket Procedure Booking System",
        description: "Targeted procedure funnels and premium visual creatives designed to attract affluent patients ready to book full-course laser & aesthetic packages.",
        stat1: "₹3.8L+",
        label1: "Added Procedure Rev",
        sub1: "Monthly high-margin billings",
        stat2: "14–18",
        label2: "Laser Consults",
        sub2: "Pre-qualified patient inquiries",
        stat3: "3.8x",
        label3: "Verified Meta ROAS",
        sub3: "Zero ad budget leakage",
        stat3Color: "text-accent-gold"
      },
      hair: {
        category: "ENGINE: HAIR PRP & GFC",
        eyebrow: "Trichology & Hair Scale Engine",
        eyebrowBadgeStyle: "bg-accent-orange/15 text-accent-orange border-accent-orange/30",
        headline: "Predictable Hair Restoration Pipeline",
        description: "Generate consistent, high-value inquiries for hair thinning, PRP therapy, and GFC treatments with localized intent targeting and automated follow-ups.",
        stat1: "12–16",
        label1: "PRP & GFC Packages",
        sub1: "Multi-session closed plans",
        stat2: "₹3,200",
        label2: "Cost Per Patient",
        sub2: "5–10 km clinic geo-radius",
        stat3: "88%",
        label3: "Show-Up Ratio",
        sub3: "WhatsApp calendar sync",
        stat3Color: "text-accent-orange"
      },
      automation: {
        category: "ENGINE: WHATSAPP 24/7",
        eyebrow: "24/7 Front-Desk Booking Automation",
        eyebrowBadgeStyle: "bg-accent-coral/15 text-accent-coral border-accent-coral/30",
        headline: "Instant WhatsApp Conversion Engine",
        description: "Convert ad clicks and website visitors straight into scheduled clinic consults with instant front-desk WhatsApp alerts and zero manual drop-offs.",
