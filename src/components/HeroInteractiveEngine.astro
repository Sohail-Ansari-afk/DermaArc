        sub3: "100% CRM & calendar synced",
        stat3Color: "text-emerald-400"
      }
    };

    let activeKey = "clinical";

    function updateActiveVertical(key: string) {
      if (!verticalData[key]) return;
      activeKey = key;
      const data = verticalData[key];

      // Update Center texts with slight fade transition
      if (engineHeadline && engineDescription) {
        engineHeadline.style.opacity = "0.3";
        engineDescription.style.opacity = "0.3";

        setTimeout(() => {
          if (activeModeLabel) activeModeLabel.textContent = data.category;
          if (engineEyebrowText) engineEyebrowText.textContent = data.eyebrow;
          engineHeadline.textContent = data.headline;
          engineDescription.textContent = data.description;

          if (stat1) stat1.textContent = data.stat1;
          if (label1) label1.textContent = data.label1;
          if (sub1) sub1.textContent = data.sub1;

          if (stat2) stat2.textContent = data.stat2;
          if (label2) label2.textContent = data.label2;
          if (sub2) sub2.textContent = data.sub2;

          if (stat3) {
            stat3.textContent = data.stat3;
            stat3.className = `font-display font-bold text-lg sm:text-2xl md:text-3xl tracking-tight transition-transform duration-200 ${data.stat3Color}`;
          }
          if (label3) label3.textContent = data.label3;
          if (sub3) sub3.textContent = data.sub3;

          engineHeadline.style.opacity = "1";
          engineDescription.style.opacity = "1";
        }, 120);
      }

      // Update satellite card highlight state
      satelliteCards.forEach((card) => {
        const vKey = card.dataset.vertical;
        const inner = card.querySelector<HTMLElement>(".card-inner");
        if (inner) {
          if (vKey === key) {
            inner.classList.add("ring-2", "ring-accent-teal", "dark:ring-accent-teal", "scale-[1.03]");
            inner.classList.remove("border-neutral-200/90", "dark:border-white/15");
          } else {
            inner.classList.remove("ring-2", "ring-accent-teal", "dark:ring-accent-teal", "scale-[1.03]");
            inner.classList.add("border-neutral-200/90", "dark:border-white/15");
          }
        }
      });

      // Update tabs state
      tabBtns.forEach((btn) => {
        const target = btn.dataset.target;
        if (target === key) {
          btn.className = "engine-tab-btn px-3 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 border whitespace-nowrap bg-neutral-900 text-white border-neutral-900 dark:bg-white dark:text-black dark:border-white shadow-sm";
        } else {
          btn.className = "engine-tab-btn px-3 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 border whitespace-nowrap bg-white/60 dark:bg-white/5 text-neutral-600 dark:text-neutral-400 border-neutral-200 dark:border-white/10 hover:bg-neutral-100 dark:hover:bg-white/10";
        }
      });
    }

    // Set initial active state
    updateActiveVertical("clinical");

    // Auto-rotate cycle through verticals
    const keys = ["clinical", "cosmetic", "hair", "automation"];
    let isUserInteracting = false;
    let autoRotateTimer: number | null = null;

    function startAutoRotate() {
      if (autoRotateTimer) clearInterval(autoRotateTimer);
      autoRotateTimer = window.setInterval(() => {
        if (!isUserInteracting) {
          const currentIdx = keys.indexOf(activeKey);
          const nextKey = keys[(currentIdx + 1) % keys.length];
          updateActiveVertical(nextKey);
        }
      }, 5500);
    }
    startAutoRotate();

    // Hover / Click on satellite cards
    satelliteCards.forEach((card) => {
      card.addEventListener("mouseenter", () => {
        isUserInteracting = true;
        const vKey = card.dataset.vertical;
        if (vKey) updateActiveVertical(vKey);
      });
      card.addEventListener("click", () => {
        isUserInteracting = true;
        const vKey = card.dataset.vertical;
        if (vKey) updateActiveVertical(vKey);
      });
    });

    // Click on tab buttons
    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        isUserInteracting = true;
        const target = btn.dataset.target;
        if (target) updateActiveVertical(target);
      });
    });

    stage?.addEventListener("mouseenter", () => {
      isUserInteracting = true;
    });

    stage?.addEventListener("mouseleave", () => {
      isUserInteracting = false;
    });

    // -------------------------------------------------------------
    // 3D Parallax & Mousemove Tilt Engine
    // -------------------------------------------------------------
    if (!stage || !tiltRig) return;

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) return;

    let mouseX = 0;
    let mouseY = 0;
    let currentTiltX = 0;
    let currentTiltY = 0;
    const maxTilt = 7; // Max tilt degrees

    function onMouseMove(e: MouseEvent) {
      if (!stage) return;
      const rect = stage.getBoundingClientRect();
      // Normalized between -1 and +1
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;
      mouseX = (x - 0.5) * 2;
      mouseY = (y - 0.5) * 2;
    }

    function onMouseLeave() {
      mouseX = 0;
      mouseY = 0;
    }

    stage.addEventListener("mousemove", onMouseMove);
    stage.addEventListener("mouseleave", onMouseLeave);

    let startTime = performance.now();

    function renderLoop() {
      const now = performance.now();
      const elapsed = (now - startTime) / 1000;

      // Silky lerp interpolation
      const targetTiltX = -mouseY * maxTilt;
      const targetTiltY = mouseX * maxTilt;
      currentTiltX += (targetTiltX - currentTiltX) * 0.08;
      currentTiltY += (targetTiltY - currentTiltY) * 0.08;

      if (tiltRig) {
        tiltRig.style.transform = `rotateX(${currentTiltX.toFixed(2)}deg) rotateY(${currentTiltY.toFixed(2)}deg)`;
      }

      // Satellite cards multi-depth parallax and gentle floating oscillation
      satelliteCards.forEach((card, idx) => {
        const depth = parseFloat(card.dataset.depth || "30");
        // Gentle float oscillation
        const floatOffset = Math.sin(elapsed * 1.5 + idx * 1.6) * 4;
        const shiftX = currentTiltY * (depth / 20);
        const shiftY = -currentTiltX * (depth / 20);

        card.style.transform = `translate3d(${shiftX.toFixed(1)}px, ${(shiftY + floatOffset).toFixed(1)}px, ${depth}px)`;
      });

      requestAnimationFrame(renderLoop);
    }

    requestAnimationFrame(renderLoop);
  });
</script>

