---

<div class="hero-engine-wrapper relative w-full pt-8 pb-4 select-none" id="heroInteractiveStage">
  <!-- Ambient backdrop lighting glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[90%] max-w-[850px] h-[360px] rounded-full blur-[110px] pointer-events-none opacity-40 dark:opacity-25" style="background: radial-gradient(circle, #00c7c7 0%, #ffc15a 50%, transparent 75%);"></div>

  <!-- 3D Perspective Stage -->
  <div class="perspective-stage relative px-3 sm:px-6 py-8 sm:py-12 lg:py-16" style="perspective: 1200px;">
    
    <!-- 3D Tilting Rig -->
    <div id="tiltRig" class="tilt-rig relative w-full max-w-4xl mx-auto transform-gpu transition-transform duration-150 ease-out" style="transform-style: preserve-3d;">
      
      <!-- =========================================================
           CENTER ENGINE CARD (Main Cockpit)
           ========================================================= -->
      <div 
        id="centerEngineCard" 
        class="center-card relative bg-[#0e0e13] text-white border border-white/15 rounded-[24px] sm:rounded-[30px] p-6 sm:p-9 md:p-10 shadow-[0_25px_60px_rgba(0,0,0,0.35)] backdrop-blur-xl z-10 transition-all duration-300"
        style="transform: translateZ(0px);"
      >
        <!-- Subtle inner highlight gradient -->
        <div class="absolute inset-0 rounded-[24px] sm:rounded-[30px] bg-gradient-to-b from-white/[0.08] via-transparent to-black/30 pointer-events-none"></div>

        <!-- Top Status Bar -->
        <div class="relative flex items-center justify-between gap-3 mb-6 sm:mb-8">
          <!-- Active Engine Pill with Glowing Pulse -->
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/[0.08] border border-white/15 backdrop-blur-md">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
            </span>
            <span class="text-[11px] font-mono font-semibold tracking-wider text-emerald-300 uppercase">
              DERMAARC / ACTIVE
            </span>
          </div>

          <!-- Secondary Mode / Sync Pill -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.05] border border-white/10 text-white/70 text-xs font-mono">
            <span class="w-2 h-2 rounded-full bg-accent-teal animate-pulse"></span>
            <span id="activeModeLabel" class="hidden sm:inline">ENGINE: CLINICAL V2.4</span>
            <span class="sm:hidden">V2.4</span>
          </div>
        </div>

        <!-- Eyebrow Badge -->
        <div class="relative inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold bg-accent-gold/15 text-accent-gold border border-accent-gold/30 mb-4 transition-all duration-300" id="engineEyebrow">
          <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <span id="engineEyebrowText">Specialized Clinical Acquisition Engine</span>
        </div>

        <!-- Main Headline -->
        <h3 id="engineHeadline" class="relative font-display font-bold text-white text-2xl sm:text-3xl md:text-4xl tracking-tight leading-tight mb-3 transition-opacity duration-200">
          High-Speed Patient Acquisition Engine
        </h3>

        <!-- Subtitle -->
        <p id="engineDescription" class="relative font-body font-light text-white/70 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto mb-8 transition-opacity duration-200">
          Sub-2s procedure pages, hyper-local Meta campaigns, and automated WhatsApp appointment routing engineered exclusively for skin & aesthetic clinics.
        </p>

        <!-- 3 Feature Columns (Fast / Clean / Direct Metrics) -->
