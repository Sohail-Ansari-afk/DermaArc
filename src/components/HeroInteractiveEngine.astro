        class="satellite-card absolute -top-8 -left-3 sm:-top-10 sm:-left-6 lg:-top-12 lg:-left-12 z-20 cursor-pointer transition-all duration-300"
        data-vertical="clinical"
        data-depth="45"
        style="transform-style: preserve-3d;"
      >
        <div class="card-inner group w-56 sm:w-64 bg-white/95 dark:bg-[#15151c]/95 backdrop-blur-md border border-neutral-200/90 dark:border-white/15 rounded-2xl p-3.5 sm:p-4 shadow-[0_16px_36px_rgba(0,0,0,0.12)] dark:shadow-[0_20px_40px_rgba(0,0,0,0.5)] transition-all duration-200 hover:scale-105 active:scale-95">
          <!-- Top Category & Tag -->
          <div class="flex items-center justify-between gap-1 mb-2.5">
            <span class="text-[10px] font-mono font-bold tracking-wider uppercase text-neutral-500 dark:text-neutral-400">
              CLINICAL PRACTICE
            </span>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-accent-teal/15 text-accent-teal border border-accent-teal/30">
              Top 3 Maps
            </span>
          </div>
          <!-- Icon & Info -->
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-[12px] bg-gradient-to-br from-[#00c7c7]/20 to-[#55d8c8]/10 flex items-center justify-center shrink-0 text-accent-teal border border-accent-teal/20">
              <!-- Medical Cross / Clinic SVG -->
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
              </svg>
            </div>
            <div class="min-w-0">
              <div class="font-display font-bold text-sm text-neutral-900 dark:text-white leading-tight truncate">
                Acne & Clinical Skin
              </div>
              <div class="text-[11px] text-neutral-500 dark:text-neutral-400 font-body leading-tight truncate mt-0.5">
                Acne • Eczema • Psoriasis
              </div>
              <div class="text-[10px] font-semibold text-accent-teal mt-1 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-accent-teal"></span>
                +22 OPD Walk-ins/mo
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2: Top-Right (Cosmetic & Laser) -->
      <div 
        class="satellite-card absolute -top-8 -right-3 sm:-top-10 sm:-right-6 lg:-top-12 lg:-right-12 z-20 cursor-pointer transition-all duration-300"
        data-vertical="cosmetic"
        data-depth="40"
        style="transform-style: preserve-3d;"
      >
        <div class="card-inner group w-56 sm:w-64 bg-white/95 dark:bg-[#15151c]/95 backdrop-blur-md border border-neutral-200/90 dark:border-white/15 rounded-2xl p-3.5 sm:p-4 shadow-[0_16px_36px_rgba(0,0,0,0.12)] dark:shadow-[0_20px_40px_rgba(0,0,0,0.5)] transition-all duration-200 hover:scale-105 active:scale-95">
          <!-- Top Category & Tag -->
          <div class="flex items-center justify-between gap-1 mb-2.5">
            <span class="text-[10px] font-mono font-bold tracking-wider uppercase text-neutral-500 dark:text-neutral-400">
              COSMETIC & LASER
            </span>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-accent-gold/15 text-accent-gold border border-accent-gold/30">
              High-Ticket
            </span>
          </div>
          <!-- Icon & Info -->
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-[12px] bg-gradient-to-br from-[#ffc15a]/20 to-[#ff8a3d]/10 flex items-center justify-center shrink-0 text-accent-gold border border-accent-gold/20">
              <!-- Laser / Sparkle SVG -->
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
              </svg>
            </div>
            <div class="min-w-0">
              <div class="font-display font-bold text-sm text-neutral-900 dark:text-white leading-tight truncate">
                Laser & Aesthetics
              </div>
              <div class="text-[11px] text-neutral-500 dark:text-neutral-400 font-body leading-tight truncate mt-0.5">
                Acne Scars • MNRF • Peels
              </div>
              <div class="text-[10px] font-semibold text-accent-gold mt-1 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-accent-gold"></span>
                ₹45k Avg Treatment
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 3: Bottom-Left (Hair Restoration & PRP) -->
      <div 
        class="satellite-card absolute -bottom-8 -left-3 sm:-bottom-10 sm:-left-6 lg:-bottom-12 lg:-left-12 z-20 cursor-pointer transition-all duration-300"
        data-vertical="hair"
        data-depth="35"
        style="transform-style: preserve-3d;"
      >
        <div class="card-inner group w-56 sm:w-64 bg-white/95 dark:bg-[#15151c]/95 backdrop-blur-md border border-neutral-200/90 dark:border-white/15 rounded-2xl p-3.5 sm:p-4 shadow-[0_16px_36px_rgba(0,0,0,0.12)] dark:shadow-[0_20px_40px_rgba(0,0,0,0.5)] transition-all duration-200 hover:scale-105 active:scale-95">
          <!-- Top Category & Tag -->
          <div class="flex items-center justify-between gap-1 mb-2.5">
            <span class="text-[10px] font-mono font-bold tracking-wider uppercase text-neutral-500 dark:text-neutral-400">
              TRICHOLOGY & PRP
            </span>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-accent-orange/15 text-accent-orange border border-accent-orange/30">
              High-Margin
            </span>
          </div>
          <!-- Icon & Info -->
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-[12px] bg-gradient-to-br from-[#ff8a3d]/20 to-[#f45135]/10 flex items-center justify-center shrink-0 text-accent-orange border border-accent-orange/20">
              <!-- Hair / Pulse SVG -->
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
            </div>
            <div class="min-w-0">
              <div class="font-display font-bold text-sm text-neutral-900 dark:text-white leading-tight truncate">
                Hair PRP & GFC Studio
              </div>
              <div class="text-[11px] text-neutral-500 dark:text-neutral-400 font-body leading-tight truncate mt-0.5">
                Hair Loss • GFC • Transplants
              </div>
              <div class="text-[10px] font-semibold text-accent-orange mt-1 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-accent-orange"></span>
                3.4x ROI Tracked
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 4: Bottom-Right (WhatsApp Front-Desk Sync) -->
      <div 
        class="satellite-card absolute -bottom-8 -right-3 sm:-bottom-10 sm:-right-6 lg:-bottom-12 lg:-right-12 z-20 cursor-pointer transition-all duration-300"
        data-vertical="automation"
        data-depth="40"
        style="transform-style: preserve-3d;"
      >
        <div class="card-inner group w-56 sm:w-64 bg-white/95 dark:bg-[#15151c]/95 backdrop-blur-md border border-neutral-200/90 dark:border-white/15 rounded-2xl p-3.5 sm:p-4 shadow-[0_16px_36px_rgba(0,0,0,0.12)] dark:shadow-[0_20px_40px_rgba(0,0,0,0.5)] transition-all duration-200 hover:scale-105 active:scale-95">
          <!-- Top Category & Tag -->
          <div class="flex items-center justify-between gap-1 mb-2.5">
            <span class="text-[10px] font-mono font-bold tracking-wider uppercase text-neutral-500 dark:text-neutral-400">
              FRONT-DESK SYNC
            </span>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-accent-coral/15 text-accent-coral border border-accent-coral/30">
              Instant Calls
            </span>
          </div>
          <!-- Icon & Info -->
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-[12px] bg-gradient-to-br from-[#55d8c8]/20 to-[#00c7c7]/10 flex items-center justify-center shrink-0 text-emerald-400 border border-emerald-400/20">
              <!-- WhatsApp / Chat SVG -->
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
            </div>
            <div class="min-w-0">
              <div class="font-display font-bold text-sm text-neutral-900 dark:text-white leading-tight truncate">
                Instant WhatsApp Booking
              </div>
              <div class="text-[11px] text-neutral-500 dark:text-neutral-400 font-body leading-tight truncate mt-0.5">
                Local Inquiries • Fast Response
              </div>
              <div class="text-[10px] font-semibold text-emerald-500 dark:text-emerald-400 mt-1 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
                &lt; 30s Confirmation
              </div>
            </div>
          </div>
        </div>
