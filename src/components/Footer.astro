---
const currentYear = new Date().getFullYear();

const footerLinks = {
  "4-Pillar System": [
    { label: "Clinic Websites & Funnels", href: "/#four-pillars" },
    { label: "Meta Ads (Instagram & Facebook)", href: "/#four-pillars" },
    { label: "Google Maps & Local SEO", href: "/#four-pillars" },
    { label: "Instagram Content Calendars", href: "/#four-pillars" },
  ],
  "Company": [
    { label: "About", href: "/about" },
    { label: "Results", href: "/#results" },
    { label: "Pricing", href: "/#pricing" },
    { label: "Blog", href: "/blog" },
  ],
  "Resources": [
    { label: "Patient Conversion Guide", href: "/patient-conversion-guide" },
    { label: "Growth Plan Audit", href: "/growth-plan" },
    { label: "Privacy Policy", href: "/privacy" },
    { label: "Terms of Service", href: "/terms" },
  ],
};
---

<footer id="site-footer" class="bg-[#09090c] text-white rounded-t-[24px] mt-auto border-t border-white/10">
  <div class="container-main pt-20 pb-8">
    <!-- Top Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8 mb-16">
      <!-- Brand Column -->
      <div class="lg:col-span-4">
        <a href="/" class="flex items-center gap-3 mb-6">
          <img src="/favicon.svg" alt="DermaArc" class="w-10 h-10 rounded-full object-contain bg-white p-1" />
          <span class="font-display text-2xl font-bold text-white tracking-tight">DermaArc</span>
        </a>
        <p class="text-zinc-400 text-base leading-relaxed max-w-md mb-4 font-body">
          The growth engine built exclusively for dermatologists. 15–30+ patient consultations every month.
        </p>
        <p class="text-zinc-400 text-sm mb-6 font-body">
          Pune, Maharashtra, India<br />
          <a href="mailto:official@dermaarc.com" class="text-zinc-300 hover:text-white transition-colors">official@dermaarc.com</a><br />
          <a href="https://wa.me/919975568867" target="_blank" rel="noopener noreferrer" class="text-zinc-300 hover:text-white transition-colors">+91 99755 68867</a>
        </p>
        <!-- Social Links -->
        <div class="flex gap-3">
          <a
            href="https://www.instagram.com/derma.arc/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-zinc-400 hover:text-white hover:bg-white/20 transition-all duration-200"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a
            href="https://wa.me/919975568867"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-zinc-400 hover:text-white hover:bg-white/20 transition-all duration-200"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
          <a
            href="https://www.linkedin.com/company/dermaarc"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-zinc-400 hover:text-white hover:bg-white/20 transition-all duration-200"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>

      <!-- Link Columns -->
      <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-3 gap-8">
        {Object.entries(footerLinks).map(([category, links]) => (
          <div>
            <h4 class="text-white font-body text-sm font-semibold uppercase tracking-wider mb-4 opacity-75">
              {category}
            </h4>
            <ul class="space-y-3">
              {links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-zinc-400 text-sm hover:text-white transition-colors duration-200 font-body"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA Strip -->
    <div class="border-t border-white/10 pt-12 pb-12 text-center">
      <h3 class="font-display text-3xl md:text-4xl font-bold mb-4 text-white">
        Ready to fill your clinic?
      </h3>
      <p class="text-zinc-300 text-base sm:text-lg mb-8 max-w-xl mx-auto leading-relaxed font-body">
        Fill out our clinic application form to receive a personalized market audit and discover how to add 15–30+ consultations every month.
      </p>
      <a
        href="/#inquiry-form"
        class="inline-flex items-center justify-center gap-2 h-14 px-8 w-full sm:w-auto rounded-full bg-white text-zinc-950 font-body font-semibold text-base hover:bg-zinc-200 transition-all duration-200 shadow-md hover:-translate-y-0.5"
      >
        Request Clinic Growth Plan →
      </a>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-body">
      <p class="text-zinc-400 text-xs">
        © {currentYear} DermaArc. All rights reserved. · Pune, Maharashtra
      </p>
      <div class="flex gap-6">
        <a href="/privacy" class="text-zinc-400 text-xs hover:text-white transition-colors">Privacy</a>
        <a href="/terms" class="text-zinc-400 text-xs hover:text-white transition-colors">Terms</a>
        <a href="/sitemap.xml" class="text-zinc-400 text-xs hover:text-white transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
