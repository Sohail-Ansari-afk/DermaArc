---
// Brand Marquee — Cities served + trust strip (seamless infinite marquee)
const cities = [
  "Pune", "Mumbai", "Bangalore", "Delhi NCR", "Hyderabad",
  "Chennai", "Ahmedabad", "Kolkata", "Jaipur", "Chandigarh",
  "Surat", "Lucknow", "Indore", "Kochi", "Nagpur",
  "Pune", "Mumbai", "Bangalore", "Delhi NCR", "Hyderabad",
];
---

<section id="brand-marquee" class="py-12 border-y border-hairline-soft overflow-hidden bg-canvas">
  <div class="w-full">
    <p class="text-center text-text-faint font-body text-xs font-semibold uppercase tracking-wider mb-8">
      Trusted by dermatologists across India
    </p>

    <!-- Marquee Track Wrapper -->
    <div class="relative w-full overflow-hidden flex">
      <!-- Group 1 -->
      <div class="marquee-group flex shrink-0 items-center">
        {cities.map((city) => (
          <div class="flex items-center gap-2.5 shrink-0 px-4 opacity-50 hover:opacity-100 transition-opacity duration-200">
            <svg class="w-4 h-4 text-accent-teal shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
            </svg>
            <span class="text-ink font-display text-lg font-bold whitespace-nowrap">{city}</span>
          </div>
        ))}
      </div>

      <!-- Group 2 (Duplicate for Seamless Loop) -->
      <div class="marquee-group flex shrink-0 items-center" aria-hidden="true">
        {cities.map((city) => (
          <div class="flex items-center gap-2.5 shrink-0 px-4 opacity-50 hover:opacity-100 transition-opacity duration-200">
            <svg class="w-4 h-4 text-accent-teal shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
            </svg>
            <span class="text-ink font-display text-lg font-bold whitespace-nowrap">{city}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-group {
    animation: marquee 35s linear infinite;
    will-change: transform;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  /* Smooth pause on hover without stutter */
  #brand-marquee:hover .marquee-group {
    animation-play-state: paused;
  }
</style>
