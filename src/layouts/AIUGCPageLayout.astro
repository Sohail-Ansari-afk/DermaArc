---
import BaseLayout from "./BaseLayout.astro";
import AIUGCNavbar from "../components/AIUGCNavbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  keywords?: string;
}

const { title, description, ogImage, keywords } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} keywords={keywords}>
  <AIUGCNavbar />
  <main class="min-h-screen pt-14">
    <slot />
  </main>
  <Footer />
</BaseLayout>
