              </div>
              <div style="border-radius:28px; overflow:hidden; aspect-ratio:9/16; position:relative; background:#000;">
                <iframe
                  src="https://www.youtube.com/embed/CGovBMplXt4?autoplay=1&mute=1&loop=1&playlist=CGovBMplXt4&controls=0&rel=0&modestbranding=1&playsinline=1"
                  title="DermaArc AI UGC – Silent Reaction Hook"
                  allow="autoplay; encrypted-media"
                  allowfullscreen
                  loading="lazy"
                  style="position:absolute; inset:0; width:100%; height:100%; border:none; pointer-events:none;"
                ></iframe>
              </div>
              <!-- Home bar -->
              <div style="display:flex; justify-content:center; margin-top:6px;">
                <div style="width:48px; height:4px; background:rgba(255,255,255,0.15); border-radius:9999px;"></div>
              </div>
            </div>
            <!-- Label -->
            <div style="text-align:center; margin-top:12px;">
              <span style="display:inline-flex; align-items:center; gap:4px; padding:3px 10px; background:#b9b9f9; color:#4434d4; border-radius:9999px; font-size:10px; font-weight:400; letter-spacing:0.1px; text-transform:uppercase;">
                📱 Silent Reaction Hook
              </span>
            </div>
          </div>

          <!-- Phone Frame 2 — Clinical Authority Hook -->
          <div class="phone-frame-wrap" style="flex:1; max-width:210px;">
            <div class="phone-shell" style="background:#1c1e54; border-radius:36px; padding:9px; box-shadow:rgba(234,34,97,0.25) 0 24px 64px, rgba(234,34,97,0.35) 0 0 0 1px;">
              <!-- Notch -->
              <div style="display:flex; justify-content:center; margin-bottom:6px;">
                <div style="width:60px; height:6px; background:#0d0d1a; border-radius:9999px;"></div>
              </div>
              <div style="border-radius:28px; overflow:hidden; aspect-ratio:9/16; position:relative; background:#000;">
                <iframe
                  src="https://www.youtube.com/embed/hCzqz07b4xU?autoplay=1&mute=1&loop=1&playlist=hCzqz07b4xU&controls=0&rel=0&modestbranding=1&playsinline=1"
