              <span style="font-size:48px; font-weight:300; color:#e3e8ee; letter-spacing:-2px; line-height:1; font-feature-settings:'tnum';">{card.num}</span>
            </div>
            <h3 style="font-size:20px; font-weight:300; color:#0d253d; letter-spacing:-0.4px; line-height:1.3;">{card.title}</h3>
            <p style="font-size:14px; font-weight:300; color:#64748d; line-height:1.6; flex:1;">{card.body}</p>
