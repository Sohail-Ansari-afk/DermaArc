          },
          {
            tag: "🔥 Fatigue Problem",
            title: "Most UGC ads fatigue in 14–21 days",
            body: "Even when you find a winning video, Meta's algorithm burns through its audience in 2–3 weeks. At $99 per video, you can afford to drop fresh winning hooks into Ads Manager every single week.",
            color: "#533afd"
          }
        ].map((card) => (
          <div class="card" style="padding:32px; position:relative; overflow:hidden;">
            <!-- Accent top bar -->
            <div style={`position:absolute; top:0; left:0; right:0; height:3px; background:${card.color};`}></div>
