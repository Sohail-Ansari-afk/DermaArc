              icon: "🎬",
              title: "Hybrid Real-Product B-Roll Integration",
              body: "We never let AI hallucinate your bottle label. We pair our 3-second AI reaction hooks seamlessly with your existing product texture shots, dropper pours, and packaging B-roll so your product looks 100% authentic."
            }
          ].map((card) => (
            <div class="card" style="padding:24px; display:flex; gap:16px; align-items:flex-start;">
              <div style="font-size:28px; flex-shrink:0; line-height:1;">{card.icon}</div>
              <div>
                <h3 style="font-size:18px; font-weight:400; color:#0d253d; letter-spacing:-0.3px; margin-bottom:8px; line-height:1.3;">{card.title}</h3>
                <p style="font-size:14px; font-weight:300; color:#64748d; line-height:1.6;">{card.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       THE PROBLEM SECTION
  ════════════════════════════════════════════════════════ -->
  <section class="section-lg" style="background:#ffffff;" id="problem">
    <div class="container-main">

      <div class="text-center mb-16" style="max-width:720px; margin-inline:auto;">
        <div class="inline-flex items-center gap-2 mb-4">
          <span class="badge-accent">The Creative Fatigue Trap</span>
        </div>
        <h2 style="color:#0d253d; margin-bottom:16px;">
          Your Meta ads aren't failing.<br/>
