            <h3 style="font-size:20px; font-weight:300; color:#0d253d; letter-spacing:-0.4px; margin-bottom:12px; line-height:1.3;">{card.title}</h3>
            <p style="font-size:14px; font-weight:300; color:#64748d; line-height:1.6;">{card.body}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       WHO WE SERVE
  ════════════════════════════════════════════════════════ -->
  <section class="section-lg" style="background:#f6f9fc;" id="who-we-serve">
    <div class="container-main">

      <div class="text-center mb-16" style="max-width:720px; margin-inline:auto;">
        <div class="inline-flex items-center gap-2 mb-4">
          <span class="badge-accent">Built for Health, Beauty &amp; Wellness</span>
        </div>
        <h2 style="color:#0d253d; margin-bottom:16px;">Engineered for three high-repeat D2C categories.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            num: "01",
            icon: "💊",
            title: "Clinical & Active Skincare Brands",
            body: "Retinols, Vitamin C serums, azelaic acid, acne patches, hyperpigmentation correctors, and barrier repair creams that thrive on \"Wait, nobody told me this ingredient rule?!\" reaction hooks.",
