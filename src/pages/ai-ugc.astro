      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
        <!-- Left: Real YouTube Shorts in Phone Frames -->
        <div class="flex gap-6 justify-center items-end">

          <!-- Phone Frame 1 — Silent Reaction Hook -->
          <div class="phone-frame-wrap" style="flex:1; max-width:210px;">
            <div class="phone-shell" style="background:#1c1e54; border-radius:36px; padding:9px; box-shadow:rgba(0,55,112,0.3) 0 24px 64px, rgba(83,58,253,0.4) 0 0 0 1px;">
              <!-- Notch -->
