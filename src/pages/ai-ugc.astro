<script>
  function formatMoney(val: number): string {
    return "$" + val.toLocaleString("en-US");
  }

  function setupUGCCalculator() {
    const videoCountInput = document.getElementById("ugc-video-count") as HTMLInputElement;
    const creatorCostInput = document.getElementById("ugc-creator-cost") as HTMLInputElement;
    const videoCountDisplay = document.getElementById("ugc-video-count-display");
    const creatorCostDisplay = document.getElementById("ugc-creator-cost-display");
    const tradCostEl = document.getElementById("ugc-trad-cost");
    const daCostEl = document.getElementById("ugc-da-cost");
    const savingsEl = document.getElementById("ugc-savings");
    const savingsPctEl = document.getElementById("ugc-savings-pct");

    function update() {
      const videos = parseInt(videoCountInput?.value || "10");
      const creatorRate = parseInt(creatorCostInput?.value || "375");

      if (videoCountDisplay) videoCountDisplay.textContent = videos + " Videos";
      if (creatorCostDisplay) creatorCostDisplay.textContent = formatMoney(creatorRate);

      const tradTotal = videos * creatorRate;
      // DermaArc: 1st free, rest at $99
      const daTotal = Math.max(0, (videos - 1)) * 99;
      const savings = tradTotal - daTotal;
      const pct = Math.round((savings / tradTotal) * 100);

      if (tradCostEl) tradCostEl.textContent = formatMoney(tradTotal);
      if (daCostEl) daCostEl.textContent = formatMoney(daTotal);
      if (savingsEl) savingsEl.textContent = formatMoney(savings);
      if (savingsPctEl) savingsPctEl.textContent = pct + "% cost reduction";
    }

    videoCountInput?.addEventListener("input", update);
    creatorCostInput?.addEventListener("input", update);

    // Preset buttons
    document.querySelectorAll(".calc-preset").forEach((btn) => {
      btn.addEventListener("click", () => {
        const val = (btn as HTMLElement).dataset.val;
        if (val && creatorCostInput) {
          creatorCostInput.value = val;
          document.querySelectorAll(".calc-preset").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          update();
        }
      });
    });

    update();
  }

  function setupUGCFAQ() {
    document.querySelectorAll(".ugc-faq-trigger").forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = btn.closest(".ugc-faq-item");
        const answer = item?.querySelector(".ugc-faq-answer") as HTMLElement;
        const icon = btn.querySelector(".ugc-faq-icon") as HTMLElement;
        const isOpen = answer?.style.display === "block";

        // Close all
        document.querySelectorAll(".ugc-faq-answer").forEach((a) => {
          (a as HTMLElement).style.display = "none";
        });
        document.querySelectorAll(".ugc-faq-icon").forEach((ic) => {
          (ic as HTMLElement).style.transform = "rotate(0deg)";
        });

        if (!isOpen) {
          if (answer) answer.style.display = "block";
          if (icon) icon.style.transform = "rotate(180deg)";
        }
      });
    });
  }

  function setupUGCForm() {
    const form = document.getElementById("ugc-claim-form") as HTMLFormElement;
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      // Show success message
      const card = form.closest(".card") as HTMLElement;
      if (card) {
        form.style.display = "none";
        card.innerHTML = `
          <div style="text-align:center; padding:40px 20px; display:flex; flex-direction:column; align-items:center; gap:16px;">
            <div style="width:64px; height:64px; border-radius:50%; background:linear-gradient(135deg,#533afd,#4434d4); display:flex; align-items:center; justify-content:center; font-size:28px;">✓</div>
            <h3 style="font-size:24px; font-weight:300; color:#0d253d; letter-spacing:-0.48px; line-height:1.2;">Application Received!</h3>
            <p style="font-size:15px; font-weight:300; color:#64748d; line-height:1.6; max-width:360px;">
              Sohail and the DermaArc team will review your brand and reach out via WhatsApp/email within a few hours with your free custom AI UGC video.
            </p>
            <div style="display:flex; gap:8px; flex-wrap:wrap; justify-content:center;">
              <span style="display:inline-flex; padding:6px 14px; background:#b9b9f9; color:#4434d4; border-radius:9999px; font-size:12px; font-weight:400;">📦 48-Hour Delivery</span>
              <span style="display:inline-flex; padding:6px 14px; background:#b9b9f9; color:#4434d4; border-radius:9999px; font-size:12px; font-weight:400;">🎁 100% Free · No Card Needed</span>
            </div>
          </div>
        `;
      }
    });
  }

  function initUGCPage() {
    setupUGCCalculator();
    setupUGCFAQ();
    setupUGCForm();
  }

  initUGCPage();
  document.addEventListener("astro:page-load", initUGCPage);
</script>
