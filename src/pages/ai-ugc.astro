---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout
  title="AI UGC Video Ads for Skincare & Wellness Brands | 1st Video FREE | DermaArc"
  description="Get your 1st custom AI UGC skincare or wellness ad video 100% FREE—then just $99 per ad-ready video. Hyper-realistic silent reaction & clinical-authority hooks for US, UK & Australian D2C brands."
  keywords="AI UGC video ads, skincare UGC ads, wellness brand video ads, AI creator videos, TikTok UGC ads, Meta UGC skincare"
>

  <!-- ══════════════════════════════════════════════════════
       TOP ANNOUNCEMENT BANNER
  ════════════════════════════════════════════════════════ -->
  <div
    style="background: linear-gradient(90deg, #533afd 0%, #4434d4 50%, #2e2b8c 100%); color:#fff; text-align:center; font-size:13px; font-weight:400; padding:10px 24px; letter-spacing:0.01em;"
  >
    🎁 <strong>Limited Offer for US, UK &amp; AU Skincare &amp; Wellness Brands:</strong> Get Your 1st Custom AI UGC Video <strong>100% FREE</strong>
  </div>

  <!-- ══════════════════════════════════════════════════════
       HERO SECTION
  ════════════════════════════════════════════════════════ -->
  <section class="stripe-mesh section-lg" style="padding-top: 80px; overflow: hidden;">
    <div class="container-main" style="position: relative; z-index: 1;">
      <div class="text-center" style="max-width: 860px; margin-inline: auto;">

        <!-- Eyebrow Badge -->
        <div class="inline-flex items-center gap-2 mb-6">
          <span class="badge-accent">Hyper-Realistic AI UGC for Skincare, Beauty &amp; Wellness Brands</span>
        </div>

        <!-- H1 -->
        <h1 style="color:#0d253d; margin-bottom: 24px;">
          Get Your 1st AI UGC Video Free.<br/>
          <span class="gradient-text">Then Just $99 Per Video.</span>
        </h1>

        <!-- Subheadline -->
        <p style="font-size:18px; font-weight:300; color:#64748d; max-width:680px; margin-inline:auto; margin-bottom:40px; line-height:1.6;">
          Stop paying $500+ per creator and waiting 3 weeks to ship serum bottles. We build hyper-realistic silent reaction hooks, clinical-authority breakdowns, and real-product B-roll mashups for US, UK &amp; Australian skincare and wellness brands—delivered in <strong style="color:#0d253d;">48 hours</strong>.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4 justify-center mb-10">
          <a href="#claim-form" class="btn-primary" style="font-size:17px; padding: 14px 28px; height:auto;">
            Claim Your 1 Free AI UGC Video →
          </a>
          <a href="#pricing" class="btn-outline" style="font-size:17px; padding: 14px 28px; height:auto;">
            See $99/Video Pricing &amp; Samples ↓
          </a>
        </div>

        <!-- Micro-Trust Pills -->
        <div class="flex flex-wrap gap-3 justify-center mb-16">
          <span style="display:inline-flex; align-items:center; gap:8px; padding:8px 18px; background:#f6f9fc; border:1px solid #e3e8ee; border-radius:9999px; font-size:13px; font-weight:300; color:#273951;">
            🎁 1st Video $0 (No Card Required)
          </span>
          <span style="display:inline-flex; align-items:center; gap:8px; padding:8px 18px; background:#f6f9fc; border:1px solid #e3e8ee; border-radius:9999px; font-size:13px; font-weight:300; color:#273951;">
            💵 $99 Per Video After (Pay As You Go)
          </span>
          <span style="display:inline-flex; align-items:center; gap:8px; padding:8px 18px; background:#f6f9fc; border:1px solid #e3e8ee; border-radius:9999px; font-size:13px; font-weight:300; color:#273951;">
            📦 Zero Product Shipping · 48-Hr Delivery
          </span>
        </div>

        <!-- Hero Visual — Real YouTube Shorts in Phone Frames -->
        <div class="flex gap-4 justify-center items-end flex-wrap">

          <!-- Phone Frame 1 — Silent Reaction (tilted left) -->
          <div style="width:150px; flex-shrink:0;" class="hidden sm:block">
            <div style="background:#1c1e54; border-radius:32px; padding:8px; box-shadow: rgba(0,55,112,0.25) 0 20px 60px, rgba(83,58,253,0.4) 0 0 0 1px; transform: rotate(-6deg) translateY(24px);">
              <!-- Notch -->
              <div style="display:flex; justify-content:center; margin-bottom:5px;">
                <div style="width:48px; height:5px; background:#0d0d1a; border-radius:9999px;"></div>
              </div>
              <div style="border-radius:26px; overflow:hidden; aspect-ratio:9/16; position:relative; background:#000;">
                <iframe
                  src="https://www.youtube.com/embed/CGovBMplXt4?autoplay=1&mute=1&loop=1&playlist=CGovBMplXt4&controls=0&rel=0&modestbranding=1&playsinline=1"
                  title="DermaArc AI UGC – Silent Reaction"
                  allow="autoplay; encrypted-media"
                  allowfullscreen
                  loading="lazy"
                  style="position:absolute; inset:0; width:100%; height:100%; border:none; pointer-events:none;"
                ></iframe>
              </div>
              <div style="display:flex; justify-content:center; margin-top:5px;">
                <div style="width:36px; height:3px; background:rgba(255,255,255,0.15); border-radius:9999px;"></div>
              </div>
            </div>
          </div>

          <!-- Phone Frame 2 (Center — featured, largest, no tilt) -->
          <div style="width:185px; flex-shrink:0;">
            <div style="background:#1c1e54; border-radius:36px; padding:10px; box-shadow: rgba(0,55,112,0.3) 0 32px 80px, rgba(83,58,253,0.6) 0 0 0 2px;">
              <!-- Notch -->
              <div style="display:flex; justify-content:center; margin-bottom:6px;">
                <div style="width:60px; height:6px; background:#0d0d1a; border-radius:9999px;"></div>
              </div>
              <div style="border-radius:28px; overflow:hidden; aspect-ratio:9/16; position:relative; background:#000;">
                <iframe
                  src="https://www.youtube.com/embed/hCzqz07b4xU?autoplay=1&mute=1&loop=1&playlist=hCzqz07b4xU&controls=0&rel=0&modestbranding=1&playsinline=1"
                  title="DermaArc AI UGC – Clinical Authority"
                  allow="autoplay; encrypted-media"
                  allowfullscreen
                  loading="lazy"
                  style="position:absolute; inset:0; width:100%; height:100%; border:none; pointer-events:none;"
                ></iframe>
              </div>
              <div style="display:flex; justify-content:center; margin-top:6px;">
                <div style="width:48px; height:4px; background:rgba(255,255,255,0.2); border-radius:9999px;"></div>
              </div>
            </div>
            <div style="text-align:center; margin-top:14px;">
              <span class="badge-accent">AI UGC · 48hr Delivery</span>
            </div>
          </div>

          <!-- Phone Frame 3 — same video 1 looping (tilted right) -->
          <div style="width:150px; flex-shrink:0;" class="hidden sm:block">
            <div style="background:#1c1e54; border-radius:32px; padding:8px; box-shadow: rgba(0,55,112,0.25) 0 20px 60px, rgba(234,34,97,0.3) 0 0 0 1px; transform: rotate(6deg) translateY(24px);">
              <!-- Notch -->
              <div style="display:flex; justify-content:center; margin-bottom:5px;">
                <div style="width:48px; height:5px; background:#0d0d1a; border-radius:9999px;"></div>
              </div>
              <div style="border-radius:26px; overflow:hidden; aspect-ratio:9/16; position:relative; background:#000;">
                <iframe
                  src="https://www.youtube.com/embed/CGovBMplXt4?autoplay=1&mute=1&loop=1&playlist=CGovBMplXt4&controls=0&rel=0&modestbranding=1&playsinline=1&start=5"
                  title="DermaArc AI UGC – Sample Reel"
                  allow="autoplay; encrypted-media"
                  allowfullscreen
                  loading="lazy"
