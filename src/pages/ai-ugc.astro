                ></iframe>
              </div>
              <!-- Home bar -->
              <div style="display:flex; justify-content:center; margin-top:6px;">
                <div style="width:48px; height:4px; background:rgba(255,255,255,0.15); border-radius:9999px;"></div>
              </div>
            </div>
            <!-- Label -->
            <div style="text-align:center; margin-top:12px;">
              <span style="display:inline-flex; align-items:center; gap:4px; padding:3px 10px; background:#ea226118; color:#ea2261; border-radius:9999px; font-size:10px; font-weight:400; letter-spacing:0.1px; text-transform:uppercase; border:1px solid #ea226130;">
                🥼 Clinical Authority Hook
              </span>
            </div>
          </div>

        </div>

        <!-- Right: 3 Proof Cards -->
        <div class="flex flex-col gap-6">
          {[
            {
              icon: "📱",
              title: "Natural Silent Reaction Hooks (0–3s)",
              body: "80% of users scroll Reels and TikTok with sound off or react to facial micro-expressions first. Our AI models deliver raw, handheld iPhone front-camera reactions—wide-eyed shock, relief sighs, hallway glances, and skincare realizations—that lock attention in the first 1.5 seconds."
