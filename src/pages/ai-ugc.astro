      {Array.from({length: 3}).map(() => (
        <span style="display:inline-flex; gap:0; padding:0;">
          {["Clinical Serums","Barrier Repair","Retinoids & Peptides","Mineral SPF","Acne Patches","LED Therapy Masks","Collagen Peptides","Gut-Skin Probiotics","Hair Growth Nutraceuticals","K-Beauty & Dermocosmetics","Clean Body Care"].map((item) => (
            <span style="display:inline-flex; align-items:center; gap:24px; padding:0 32px; font-size:13px; font-weight:300; color:#64748d; letter-spacing:0.02em;">
              <span style="width:5px; height:5px; border-radius:50%; background:#533afd; display:inline-block; flex-shrink:0;"></span>
              {item}
            </span>
          ))}
        </span>
      ))}
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════
       4-METRIC STATS BAR
  ════════════════════════════════════════════════════════ -->
  <section style="background:#ffffff; border-bottom:1px solid #e3e8ee; padding: 48px 0;">
    <div class="container-main">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-px" style="background:#e3e8ee; border:1px solid #e3e8ee; border-radius:12px; overflow:hidden; box-shadow: rgba(0,55,112,0.08) 0 1px 3px;">
        {[
          { value: "$0", label: "Your 1st Custom AI UGC Video", sub: "Test our quality before spending a cent" },
          { value: "$99", label: "Per Finished Ad Video", sub: "vs. $500–$1,200 US/UK pro creator average" },
          { value: "48 Hrs", label: "From Product Link to Ad-Ready MP4", sub: "vs. 15–20 business days at traditional agencies" },
          { value: "$0 Extra", label: "Perpetual Paid Ad Usage Rights", sub: "Run on Meta, TikTok & YouTube Shorts forever" },
        ].map((stat) => (
          <div style="background:#fff; padding:32px 24px; text-align:center;">
            <div class="money-fig" style="font-size:clamp(32px,4vw,48px); font-weight:300; color:#533afd; letter-spacing:-1.4px; line-height:1.03; margin-bottom:8px;">{stat.value}</div>
            <div style="font-size:14px; font-weight:400; color:#0d253d; margin-bottom:4px; line-height:1.3;">{stat.label}</div>
            <div style="font-size:12px; font-weight:300; color:#64748d; line-height:1.4;">{stat.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
