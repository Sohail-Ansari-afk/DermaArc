---
import PageLayout from "../layouts/PageLayout.astro";
import CTASection from "../components/CTASection.astro";

const values = [
  {
    title: "Dermatology-only.",
    description: "We don't work with restaurants, gyms, or general clinics. 100% of our attention, knowledge, and resources go to dermatologists. We know your patients, your treatments, and your compliance requirements.",
  },
  {
    title: "Zero vanity metrics.",
    description: "We report on total inquiries, cost per lead, and clinic walk-ins. Not impressions, not reach, not engagement rate. Instagram followers don't pay your rent — bookings do.",
  },
  {
    title: "One system, not five freelancers.",
    description: "Website, ads, Google Maps, Instagram — all managed in-house under one retainer. No finger-pointing between vendors. One team accountable for one number: patients booked.",
  },
  {
    title: "Micro-budget efficient.",
    description: "We've proven ₹14.94 cost per lead on starter budgets of ₹100–150/day. You don't need lakhs in ad spend to fill your clinic — you need the right system.",
  },
];
---

<PageLayout
  title="About"
  description="DermaArc is a founder-led patient acquisition agency built exclusively for dermatologists by Sohail Ansari in Pune. Learn our story and what makes us different."
>
  <!-- Hero with Stripe Gradient Mesh -->
  <section class="stripe-mesh section-lg relative overflow-hidden">
    <div class="container-main relative z-10">
      <div class="max-w-3xl">
        <p class="eyebrow text-ink-mute mb-3">About DermaArc</p>
        <h1 class="font-display font-light text-ink mb-6" style="font-size: clamp(36px, 6vw, 56px); letter-spacing: -1.4px; line-height: 1.03; text-wrap: balance;">
          One founder. One mission.<br />
          <span class="gradient-text">Fill dermatology clinics.</span>
        </h1>
        <p class="text-ink-secondary font-body font-light text-lg sm:text-xl leading-relaxed mb-6">
          DermaArc was founded by <strong class="font-normal text-ink">Sohail Ansari</strong> in Pune, Maharashtra with a simple observation: dermatologists are brilliant clinicians but terrible at digital marketing — and the generic agencies they hire don't understand dermatology.
        </p>
        <p class="text-ink-mute font-body font-light text-base leading-relaxed mb-6">
          The result? Board-certified dermatologists lose patients to med spas that outspend them online. Clinics pay three different freelancers and get zero accountability. Instagram posts go out with no strategy. Google listings sit unoptimised while competitors rank above them.
        </p>
        <p class="text-ink-mute font-body font-light text-base leading-relaxed">
          DermaArc exists to fix this. We've built one unified growth engine — the 4-Pillar System — that replaces disconnected freelancers with a single team, a single retainer, and a single metric that matters: patients booked.
        </p>
      </div>
    </div>
  </section>

  <!-- Founder -->
  <section class="section-lg bg-canvas-soft border-t border-hairline">
    <div class="container-main">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center max-w-5xl mx-auto">
        <!-- Photo card -->
        <div class="lg:col-span-4">
          <div class="card p-8 text-center max-w-[280px] mx-auto">
            <div class="w-20 h-20 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-display text-3xl font-light" style="background-color: #533afd;">
              S
            </div>
            <p class="text-ink font-display font-light text-xl mb-1">Sohail Ansari</p>
            <p class="eyebrow text-primary-deep">Founder &amp; Head of Patient Acquisition</p>
          </div>
        </div>

        <!-- Bio -->
        <div class="lg:col-span-8">
          <h2 class="font-display font-light text-ink mb-4" style="font-size: clamp(26px, 3.5vw, 36px); letter-spacing: -0.64px; line-height: 1.15;">
            Meet the founder.
          </h2>
          <p class="text-ink-secondary font-body font-light text-base leading-relaxed mb-4">
            Sohail Ansari built DermaArc after seeing first-hand how dermatology clinics were being outmarketed by med spas and generic aesthetic clinics. With a background in performance marketing and a deep understanding of the Indian healthcare landscape, he designed the 4-Pillar System specifically for the challenges dermatologists face.
          </p>
          <p class="text-ink-secondary font-body font-light text-base leading-relaxed mb-8">
            Every clinic that works with DermaArc works directly with Sohail and his team — no account managers hiding behind dashboards, no juniors running your campaigns. Founder-led means exactly that.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="mailto:official@dermaarc.com" class="btn-outline text-sm">
              official@dermaarc.com
            </a>
            <a href="https://wa.me/919975568867" target="_blank" rel="noopener noreferrer" class="btn-primary text-sm">
              Connect on WhatsApp →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section-lg bg-canvas border-t border-hairline">
    <div class="container-main">
      <div class="text-center mb-16">
        <p class="eyebrow text-ink-mute mb-3">Our Principles</p>
        <h2 class="font-display font-light text-ink" style="font-size: clamp(28px, 4vw, 44px); letter-spacing: -0.96px; line-height: 1.15;">
          What makes us different.
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {values.map((value) => (
          <div class="card">
            <h3 class="font-display font-light text-ink text-xl mb-3" style="letter-spacing: -0.2px;">
              {value.title}
            </h3>
            <p class="text-ink-secondary font-body font-light text-[15px] leading-relaxed">
              {value.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Key Numbers: Stripe Cream Band (Warm Interlude) -->
  <section class="section bg-canvas-cream border-t border-hairline">
    <div class="container-main">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[
          { value: "2024", label: "Founded" },
          { value: "₹14.94", label: "Lowest CPL Achieved" },
          { value: "61K+", label: "Residents Reached" },
          { value: "100%", label: "Dermatology Focus" },
        ].map((stat) => (
          <div>
            <div class="font-display font-light text-ink text-3xl sm:text-4xl mb-2 money-fig">
              {stat.value}
            </div>
            <p class="eyebrow text-ink-mute">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</PageLayout>
