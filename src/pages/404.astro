---
import PageLayout from "../layouts/PageLayout.astro";

const quickLinks = [
  { title: "4-Pillar Growth Engine", href: "/#four-pillars", desc: "Websites, Meta Ads, Local SEO, and Instagram Content" },
  { title: "Free Growth Plan Audit", href: "/growth-plan", desc: "20-minute clinic assessment checklist" },
  { title: "Patient Conversion Guide", href: "/patient-conversion-guide", desc: "Turn medical patients into cosmetic bookings" },
  { title: "Tailored Partnerships", href: "/#pricing", desc: "Area exclusivity & custom retainer" },
];
---

<PageLayout
  title="404 — Page Not Found"
  description="The dermatology marketing page you were looking for does not exist or has been moved."
>
  <section class="stripe-mesh section-lg min-h-[75vh] flex items-center justify-center relative overflow-hidden">
    <div class="container-narrow text-center relative z-10">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 mb-6">
        <span class="badge-accent">Error 404 · Page Not Found</span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-display font-light text-ink mb-4" style="font-size: clamp(36px, 6vw, 64px); letter-spacing: -1.4px; line-height: 1.05; text-wrap: balance;">
        Lost in the <span class="gradient-text">clinic funnels?</span>
      </h1>

      <p class="text-ink-mute font-body font-light text-base sm:text-lg max-w-lg mx-auto mb-10 leading-relaxed">
        The clinic page, guide, or resource you were looking for has moved or does not exist. Here are the most visited resources:
      </p>

      <!-- Quick Navigation Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto mb-10 text-left">
        {quickLinks.map((item) => (
          <a
            href={item.href}
            class="card p-5 group flex flex-col justify-between"
          >
            <div class="flex items-center justify-between mb-1">
              <span class="font-display font-light text-ink text-base group-hover:text-primary transition-colors" style="letter-spacing: -0.2px;">
                {item.title}
              </span>
              <svg class="w-4 h-4 text-ink-mute group-hover:text-primary group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
            <p class="text-ink-mute font-body font-light text-xs">
              {item.desc}
            </p>
          </a>
        ))}
      </div>

      <!-- Actions: Pill CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full max-w-md sm:max-w-none mx-auto">
        <a href="/" class="btn-primary w-full sm:w-auto">
          Back to Homepage →
        </a>
        <a
          href="https://wa.me/919975568867?text=Hi%20DermaArc%2C%20I%20hit%20a%20404%20error%20page%20on%20your%20website."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline w-full sm:w-auto"
        >
          WhatsApp Support
        </a>
      </div>
    </div>
  </section>
</PageLayout>
