---
import PageLayout from "../layouts/PageLayout.astro";

// UK-specific case studies & metrics
const ukCaseMetrics = [
  { value: "£1.85", label: "Average CPL on Meta (London & Manchester)" },
  { value: "15–30+", label: "Private Consultations / Month" },
  { value: "100%", label: "ASA, CAP & GMC Standards Compliant" },
  { value: "1 Clinic", label: "Per Postcode Sector Exclusivity" },
];

const ukPillars = [
  {
    number: "01",
    title: "High-Converting UK Treatment Landing Pages",
    subtitle: "Engineered for private skin & cosmetic procedures.",
    description: "Fast, sub-2-second mobile pages built specifically for high-margin private procedures: RF Microneedling, Polynucleotides, Profhilo®, Laser Resurfacing, Acne & Rosacea Protocols, and Private Mole Checks — with 1-tap WhatsApp and online clinic diary integration.",
    features: [
      "Sub-2s mobile loading speed",
      "1-tap WhatsApp Business & online booking diary",
      "Private procedure micro-funnels",
      "After-hours private patient capture",
    ],
  },
  {
    number: "02",
    title: "Postcode-Targeted Meta Ads (100% ASA & CAP Compliant)",
    subtitle: "Never risk ad account bans on POM regulations.",
    description: "Because the UK ASA & CAP Code strictly prohibits advertising Prescription-Only Medicines (POMs like Botox®) directly to the public, generic agencies routinely get UK clinic ad accounts banned. We run 100% compliant, consultation-led Meta campaigns targeted to affluent postcodes within 3–8 miles of your clinic.",
    features: [
      "Strict ASA / CAP code adherence",
      "Postcode radius fencing (3–8 miles)",
      "Instant reception lead alerts",
      "Consultation-led clinical angles",
    ],
  },
  {
    number: "03",
    title: "Google Business Profile & Local Map Pack SEO",
    subtitle: "Dominate UK local searches for private dermatology.",
    description: "Rank in the Top 3 on Google Maps when private self-pay and insured patients in your borough or town search 'Private Dermatologist near me', 'Skin Clinic London', or 'Acne Scar Treatment Manchester'.",
    features: [
      "Google Maps Top 3 ranking",
      "UK healthcare directory syndication",
      "Geo-tagged clinic photography",
      "Automated Google & Trustpilot review QR stands",
    ],
  },
  {
    number: "04",
    title: "Authority-Led Instagram Reels & Silent UGC",
    subtitle: "GMC-compliant medical authority without cringe trends.",
    description: "Maintain full GMC cosmetic standards without ever doing cringey dances. Spend just 45 minutes a month filming simple in-clinic b-roll while we handle hooks, scripting, editing, and medical captions.",
    features: [
      "12–15 monthly clinical posts & Reels",
      "GMC ethical standards compliance",
      "45-minute batch filming scripts",
      "Doctor personal branding",
    ],
  },
];

const ukOnboardingSteps = [
  {
    step: "01",
    day: "Day 1",
    title: "Free Postcode Sector & Competitor Audit",
    detail: "We audit your current Google Maps ranking, website conversion leaks, and local aesthetic clinic ad spend across your target postcodes.",
  },
  {
    step: "02",
    day: "Day 2",
    title: "Custom Funnel & Retainer Proposal",
    detail: "You receive an exact monthly growth roadmap and transparent retainer quote matched to your clinical chair capacity.",
  },
  {
    step: "03",
    day: "Days 3–14",
    title: "Full 4-Pillar Launch",
    detail: "Your landing page, local SEO, Instagram reels, and ASA-compliant Meta campaigns go live with instant reception lead alerts.",
  },
];

const ukIncluded = [
  "Conversion-first private clinic landing pages",
  "Postcode-fenced Meta ad campaigns (Instagram + Facebook)",
  "Full ASA / CAP, GMC & CQC advertising compliance",
  "Google Business Profile optimisation & UK local citations",
  "12–15 Instagram authority posts + Reel scripts per month",
  "Instant WhatsApp & Reception Lead Triage integration",
  "Automated post-appointment 5-star Google & Trustpilot review flow",
  "Monthly attribution report (Inquiries, CPL, Booked Consultations)",
  "Dedicated UK clinic growth manager",
];
---

<PageLayout
  title="Digital Marketing Agency for UK Dermatologists & Aesthetic Clinics"
  description="DermaArc UK is the premier patient acquisition agency for UK Consultant Dermatologists and CQC-registered skin clinics. 15–30+ high-value private patient bookings every month via postcode-fenced Meta ads, Google Map Pack SEO, and ASA/GMC-compliant funnels."
>
  <!-- Hero Section with Stripe Gradient Mesh Backdrop -->
  <section class="stripe-mesh relative overflow-hidden" style="padding-block: clamp(80px, 9vw, 120px);">
    <div class="container-main relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Eyebrow Pill -->
        <div class="inline-flex items-center gap-2 mb-8">
          <span class="badge-accent">
            🇬🇧 Built for UK Consultant Dermatologists &amp; CQC-Registered Clinics
          </span>
        </div>

        <!-- Headline: display-xxl (56px, weight 300, -1.4px tracking) -->
        <h1
          class="font-light mb-6"
          style="font-size: clamp(36px, 6vw, 56px); letter-spacing: -1.4px; line-height: 1.03; color: #0d253d; font-weight: 300; text-wrap: balance;"
        >
          Add 15–30+ high-value private patient bookings.<br />
          <span class="gradient-text">Exclusively for UK skin clinics.</span>
        </h1>

        <!-- Subtitle: body-lg (16px, weight 300) -->
        <p
          class="max-w-2xl mx-auto mb-10 font-light"
          style="font-size: 16px; line-height: 1.4; color: #64748d; font-weight: 300;"
        >
          The 4-Pillar Patient Acquisition Engine for UK Dermatology &amp; Aesthetic Clinics. We combine conversion-first procedure landing pages, postcode-targeted Meta Ads, Google Map Pack SEO, and ASA/GMC-compliant content to fill your clinic diary.
        </p>

        <!-- CTA Row: Single indigo pill CTA + secondary outline -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full max-w-md sm:max-w-none mx-auto">
          <a href="#uk-partnership" class="btn-primary w-full sm:w-auto">
            Check Your Postcode Availability →
          </a>
          <a href="#uk-pillars" class="btn-outline w-full sm:w-auto">
            See How the 4-Pillar System Works
          </a>
        </div>

        <!-- Trust Signals Row -->
        <div class="mt-12 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-xs sm:text-sm font-light text-ink-mute">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-primary shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            1 Clinic Per Postcode Sector Exclusivity
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-primary shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            100% ASA, CAP &amp; GMC Compliant
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-primary shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            No Long-Term Lock-in · 30-Day Rolling
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- UK Stats Bar: Stripe Cream Band (Warm Interlude) -->
  <section class="section bg-canvas-cream border-t border-hairline">
    <div class="container-main">
      <div class="card-cream p-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-4 text-center">
          {ukCaseMetrics.map((stat) => (
            <div>
              <div class="font-display font-light text-ink text-2xl sm:text-3xl mb-1 money-fig">
                {stat.value}
              </div>
              <p class="eyebrow text-ink-mute">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- The 4-Pillar System for UK Clinics -->
  <section id="uk-pillars" class="section-lg bg-canvas border-t border-hairline">
    <div class="container-main">
      <div class="text-center mb-16">
        <p class="eyebrow text-ink-mute mb-3">UK Clinical Growth Framework</p>
        <h2 class="font-display font-light text-ink mb-4" style="font-size: clamp(30px, 4vw, 48px); letter-spacing: -0.96px; line-height: 1.15; text-wrap: balance;">
          The 4-Pillar System for UK Private Practices.
        </h2>
        <p class="text-ink-mute font-body font-light text-base max-w-2xl mx-auto leading-relaxed">
          Engineered specifically around UK private healthcare economics, NHS-to-private conversion, and strict CAP advertising regulations.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {ukPillars.map((pillar) => (
          <div class="card p-8 flex flex-col justify-between">
            <div>
              <span class="badge-accent mb-4 inline-block">Pillar {pillar.number}</span>
              <h3 class="font-display font-light text-ink text-xl mb-2" style="letter-spacing: -0.2px;">
                {pillar.title}
              </h3>
              <p class="text-primary font-display font-light text-sm mb-3">
                {pillar.subtitle}
              </p>
              <p class="text-ink-secondary font-body font-light text-sm leading-relaxed mb-6">
                {pillar.description}
              </p>
            </div>
            <ul class="space-y-2.5 pt-4 border-t border-hairline">
              {pillar.features.map((feature) => (
                <li class="flex items-center gap-2 text-xs font-light text-ink-secondary">
                  <div class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></div>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- UK Partnership / Dark Card Section (Option 3 Onboarding Blueprint) -->
  <section id="uk-partnership" class="section-lg bg-canvas-soft border-t border-hairline">
    <div class="container-main">
      <div class="text-center mb-16">
        <p class="eyebrow text-ink-mute mb-3">Tailored UK Clinic Partnerships</p>
        <h2 class="font-display font-light text-ink mb-4" style="font-size: clamp(30px, 4vw, 48px); letter-spacing: -0.96px; line-height: 1.15; text-wrap: balance;">
          Lock out competing clinics in your postcode.
        </h2>
        <p class="text-ink-mute font-body font-light text-base max-w-2xl mx-auto leading-relaxed">
          We strictly partner with only 1 dermatology clinic per postcode sector so we never bid against ourselves or split local patient inquiries.
        </p>
      </div>

      <!-- Scarcity Card: Stripe Featured Tier in #1c1e54 -->
      <div class="max-w-2xl mx-auto">
        <div class="card-featured p-6 sm:p-10 md:p-12 relative overflow-hidden" style="border: 1px solid rgba(255, 255, 255, 0.12);">
          <div class="absolute -top-24 -right-24 w-64 h-64 rounded-full pointer-events-none opacity-20" style="background: radial-gradient(circle, #533afd 0%, transparent 70%);"></div>

          <!-- Top Badge & Scarcity -->
          <div class="flex items-center justify-between gap-3 mb-8 flex-wrap">
            <span class="badge-accent" style="background-color: rgba(185, 185, 249, 0.2); color: #b9b9f9;">
              EXCLUSIVE POSTCODE PARTNER
            </span>
            <span class="font-body text-xs font-light text-slate-300">
              No long-term lock-in · 30-day rolling
            </span>
          </div>

          <!-- Hero Scarcity Headline -->
          <div class="mb-8">
            <div class="flex items-baseline gap-3 flex-wrap">
              <span
                class="font-display font-light text-white"
                style="font-size: clamp(34px, 5vw, 52px); letter-spacing: -1.2px; line-height: 1.05;"
              >
                1 Clinic Per Postcode Sector
              </span>
            </div>
            <p class="text-slate-300 font-body text-xs sm:text-sm mt-3 font-light leading-relaxed">
              Tailored monthly retainer based on your clinic size &amp; priority treatments · Recommended starting ad spend: £15–£25/day paid directly to Meta
            </p>
          </div>

          <!-- Hairline Divider -->
          <div class="border-t border-white/10 mb-8"></div>

          <!-- Checklist -->
          <h4 class="font-display text-xs uppercase tracking-wider text-white font-medium mb-5">
            EVERYTHING INCLUDED IN YOUR UK GROWTH ENGINE:
          </h4>
          <ul class="space-y-3.5 mb-10">
            {ukIncluded.map((item) => (
              <li class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5" style="background-color: rgba(83, 58, 253, 0.35);">
                  <svg class="w-3.5 h-3.5 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                </div>
                <span class="text-slate-100 font-body text-sm font-light leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>

          <!-- Hairline Divider -->
          <div class="border-t border-white/10 mb-8"></div>

          <!-- 3-Step What Happens Next Onboarding Preview (Option 3) -->
          <h4 class="font-display text-xs uppercase tracking-wider text-slate-300 font-medium mb-5">
            WHAT HAPPENS NEXT (3-STEP ONBOARDING):
          </h4>
          <div class="space-y-4 mb-10">
            {ukOnboardingSteps.map((s) => (
              <div class="p-4 rounded-lg bg-white/[0.04] border border-white/10 flex items-start gap-3.5">
                <div class="w-7 h-7 rounded-full flex items-center justify-center shrink-0 text-white font-display text-xs font-medium" style="background-color: #533afd;">
                  {s.step}
                </div>
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-white font-display text-sm font-light">{s.title}</span>
                    <span class="eyebrow text-[9px] text-slate-400">({s.day})</span>
                  </div>
                  <p class="text-slate-300 font-body text-xs font-light leading-relaxed">
                    {s.detail}
                  </p>
                </div>
              </div>
            ))}
          </div>

          <!-- Single Dominant Pill CTA -->
          <a href="#inquiry-form" class="btn-primary w-full text-center">
            Claim Your Postcode &amp; Get a Custom Quote →
          </a>

          <p class="text-slate-400 font-body text-xs text-center mt-4 font-light">
            Takes 60 seconds · Free UK local competitor &amp; Map Pack audit included
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Application Form Section -->
  <section id="inquiry-form" class="stripe-mesh section-lg bg-canvas relative overflow-hidden border-t border-hairline">
    <div class="container-main relative z-10">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <span class="badge-accent mb-3 inline-block">UK Practice Audit</span>
        <h2 class="font-display font-light text-ink mb-4" style="font-size: clamp(32px, 4.5vw, 48px); letter-spacing: -1.2px; line-height: 1.08;">
          Request your postcode availability audit.
        </h2>
        <p class="font-body font-light text-ink-mute text-base leading-relaxed">
          Sohail will audit your UK postcode catchment, local Map Pack competitors, and procedure landing page leaks within 24 hours.
        </p>
      </div>

      <div class="card p-6 sm:p-10 max-w-2xl mx-auto" style="box-shadow: rgba(0,55,112,0.08) 0 8px 24px, rgba(0,55,112,0.04) 0 2px 6px;">
        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-5"
        >
          <input type="hidden" name="access_key" value="5335ef61-bcd9-4e43-ae81-932d76b7f9e1" />
          <input type="hidden" name="subject" value="New UK Clinic Inquiry — DermaArc UK" />
          <input type="hidden" name="from_name" value="DermaArc UK Inquiries" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block eyebrow text-ink mb-2">Doctor / Clinical Director Name *</label>
              <input type="text" name="name" required placeholder="e.g., Dr. Oliver Wright" class="input-stripe" />
            </div>
            <div>
              <label class="block eyebrow text-ink mb-2">Clinic / Practice Name *</label>
              <input type="text" name="clinic_name" required placeholder="e.g., Harley Street Skin &amp; Laser" class="input-stripe" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block eyebrow text-ink mb-2">WhatsApp / Phone Number *</label>
              <input type="tel" name="phone" required placeholder="+44 7911 123456" class="input-stripe" />
            </div>
            <div>
              <label class="block eyebrow text-ink mb-2">Email Address *</label>
              <input type="email" name="email" required placeholder="director@clinic.co.uk" class="input-stripe" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block eyebrow text-ink mb-2">UK City &amp; Postcode Sector *</label>
              <input type="text" name="postcode" required placeholder="e.g., London W1G / Manchester M2" class="input-stripe" />
            </div>
            <div>
              <label class="block eyebrow text-ink mb-2">Primary Clinical Focus *</label>
              <select name="clinic_type" required class="input-stripe" style="padding-block: 6px;">
                <option value="Private Dermatology & Mole Checks">Private Dermatology &amp; Mole Checks</option>
                <option value="Aesthetic & Laser Clinic">Aesthetic &amp; Laser (RF Microneedling, Polynucleotides)</option>
                <option value="Hair Restoration & PRP Studio">Hair Restoration &amp; PRP Therapy</option>
                <option value="Comprehensive CQC Aesthetic Center">Comprehensive CQC Aesthetic Center</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block eyebrow text-ink mb-2">Current Biggest Challenge or Target Growth Goal</label>
            <textarea
              name="message"
              rows="3"
              placeholder="e.g., We want to scale private self-pay consultations for RF Microneedling &amp; Acne Scars while staying 100% compliant with ASA rules."
              class="w-full p-3 rounded-[6px] bg-canvas border border-hairline-input text-ink placeholder:text-ink-mute/70 text-[15px] font-light focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all resize-none"
            ></textarea>
          </div>

          <button type="submit" class="btn-primary w-full">
            Submit Postcode Audit Request →
          </button>
          <p class="text-ink-mute font-body text-[11px] text-center mt-3 font-light">
            🔒 100% Confidential · We strictly respect UK GDPR &amp; data privacy
          </p>
        </form>
      </div>
    </div>
  </section>
</PageLayout>
