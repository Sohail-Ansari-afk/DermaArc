---
import PageLayout from "../layouts/PageLayout.astro";
import CTASection from "../components/CTASection.astro";
---

<PageLayout
  title="Patient Conversion Guide"
  description="Free guide: How to convert medical dermatology patients into high-value cosmetic bookings. The Medical-to-Cosmetic Pipeline explained."
>
  <!-- Hero -->
  <section class="section-lg">
    <div class="container-main">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Left: Copy -->
        <div>
          <span class="badge-accent mb-6 inline-block">Free Guide</span>
          <h1 class="font-display font-bold text-ink mb-6" style="font-size: clamp(32px, 5vw, 48px); line-height: 1.0;">
            The Medical-to-Cosmetic<br />
            <span class="gradient-text">Patient Conversion Guide.</span>
          </h1>
          <p class="text-text-muted font-body text-lg font-light leading-relaxed mb-6">
            Every dermatology practice sits on an untapped goldmine: medical patients who are ideal candidates for cosmetic treatments. This guide shows you exactly how to convert them.
          </p>

          <!-- What's Inside -->
          <ul class="space-y-3 mb-8">
            {[
              "Why medical derm patients are your best cosmetic leads",
              "The 4-stage Attract → Educate → Convert → Retain pipeline",
              "In-office touchpoints that introduce cosmetic options naturally",
              "WhatsApp automation sequences for patient nurturing",
              "NMC-compliant content templates for cosmetic promotion",
              "Case study: How one Pune clinic added ₹3L/month in cosmetic revenue",
            ].map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-accent-teal shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-ink font-body text-sm">{item}</span>
              </li>
            ))}
          </ul>

          <a href="https://wa.me/919975568867?text=Hi%20DermaArc%2C%20I%27d%20like%20the%20free%20Patient%20Conversion%20Guide." target="_blank" rel="noopener noreferrer" class="btn-primary h-14 px-8 text-base">
            Get the Free Guide
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
          <p class="text-text-faint font-body text-xs mt-4">
            Sent via WhatsApp · PDF format · No email required
          </p>
        </div>

        <!-- Right: Guide Preview -->
        <div class="card-featured p-8 md:p-12">
          <div class="bg-canvas rounded-[16px] p-8 text-center mb-6">
            <div class="w-20 h-20 rounded-[24px] bg-primary mx-auto mb-4 flex items-center justify-center">
              <svg class="w-10 h-10 text-on-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="font-display text-xl font-bold text-ink mb-2">
              Patient Conversion Guide
            </h3>
            <p class="text-text-muted font-body text-sm">
              The Medical-to-Cosmetic Pipeline<br />by DermaArc
            </p>
          </div>

          <!-- Pipeline Preview -->
          <div class="space-y-3">
            {["Attract", "Educate", "Convert", "Retain"].map((stage, i) => (
              <div class="flex items-center gap-3 bg-canvas rounded-[16px] p-4">
                <span class:list={[
                  "font-display text-sm font-bold",
                  i === 0 ? "text-accent-teal" : i === 1 ? "text-accent-aqua" : i === 2 ? "text-accent-gold" : "text-accent-coral",
                ]}>
                  0{i + 1}
                </span>
                <span class="font-body text-sm font-semibold text-ink">{stage}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</PageLayout>

