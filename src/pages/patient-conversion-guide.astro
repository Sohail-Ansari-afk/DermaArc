---
import PageLayout from "../layouts/PageLayout.astro";
import CTASection from "../components/CTASection.astro";
---

<PageLayout
  title="Patient Conversion Guide"
  description="Free guide: How to convert medical dermatology patients into high-value cosmetic bookings. The Medical-to-Cosmetic Pipeline explained."
>
  <!-- Hero with Stripe Gradient Mesh -->
  <section class="stripe-mesh section-lg relative overflow-hidden">
    <div class="container-main relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Left: Copy -->
        <div>
          <span class="badge-accent mb-4 inline-block">Free Clinical Guide</span>
          <h1 class="font-display font-light text-ink mb-6" style="font-size: clamp(32px, 5vw, 48px); letter-spacing: -1.2px; line-height: 1.08; text-wrap: balance;">
            The Medical-to-Cosmetic<br />
            <span class="gradient-text">Patient Conversion Guide.</span>
          </h1>
          <p class="text-ink-secondary font-body font-light text-base sm:text-lg leading-relaxed mb-6">
            Every dermatology practice sits on an untapped goldmine: medical patients who are ideal candidates for cosmetic treatments. This guide shows you exactly how to convert them.
          </p>

          <!-- What's Inside -->
          <ul class="space-y-3 mb-8">
            {[
              "Why medical derm patients are your best cosmetic leads",
              "The 4-stage Attract → Educate → Convert → Retain pipeline",
              "In-office touchpoints that introduce cosmetic options naturally",
              "WhatsApp automation sequences for patient nurturing",
              "NMC-compliant content templates for cosmetic promotion",
              "Case study: How one Pune clinic added ₹3L/month in cosmetic revenue",
            ].map((item) => (
              <li class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5" style="background-color: #b9b9f9; color: #4434d4;">
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                </div>
                <span class="text-ink-secondary font-body font-light text-sm">{item}</span>
              </li>
            ))}
          </ul>

          <a href="https://wa.me/919975568867?text=Hi%20DermaArc%2C%20I%27d%20like%20the%20free%20Patient%20Conversion%20Guide." target="_blank" rel="noopener noreferrer" class="btn-primary">
            Get the Free Guide on WhatsApp →
          </a>
          <p class="text-ink-mute font-body text-xs mt-3 font-light">
            Sent via WhatsApp · PDF format · No email or credit card required
          </p>
        </div>

        <!-- Right: Guide Preview (Card with Level 2 Shadow) -->
        <div class="card p-8 sm:p-10 relative overflow-hidden" style="box-shadow: rgba(0,55,112,0.08) 0 8px 24px, rgba(0,55,112,0.04) 0 2px 6px;">
          <div class="bg-canvas-soft rounded-lg p-8 text-center mb-6 border border-hairline">
            <div class="w-16 h-16 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-display text-2xl font-light" style="background-color: #533afd;">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="font-display font-light text-ink text-xl mb-2" style="letter-spacing: -0.2px;">
              Patient Conversion Guide
            </h3>
            <p class="text-ink-mute font-body font-light text-xs">
              The Medical-to-Cosmetic Pipeline<br />by DermaArc
            </p>
          </div>

          <!-- Pipeline Preview -->
          <div class="space-y-2.5">
            {["Attract", "Educate", "Convert", "Retain"].map((stage, i) => (
              <div class="flex items-center gap-3 bg-canvas-soft rounded-lg p-3.5 border border-hairline">
                <span class="font-display text-xs font-medium text-primary money-fig">
                  0{i + 1}
                </span>
                <span class="font-body text-sm font-normal text-ink">{stage} Stage</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</PageLayout>
