---
import PageLayout from "../layouts/PageLayout.astro";
import ROICalculator from "../components/ROICalculator.astro";
import PricingSection from "../components/PricingSection.astro";
import CTASection from "../components/CTASection.astro";

const auditChecklist = [
  {
    category: "Website & Funnels",
    items: [
      "Mobile load speed (target: under 2 seconds)",
      "WhatsApp booking integration (1-tap booking)",
      "Procedure-specific landing pages",
      "After-hours lead capture flow",
      "Trust signals (certifications, reviews, photos)",
    ],
  },
  {
    category: "Meta Ads Readiness",
    items: [
      "Facebook Business Manager setup",
      "Instagram business profile connected",
      "Meta Pixel installed on website",
      "NMC-compliant creative library",
      "Geo-targeting radius defined",
    ],
  },
  {
    category: "Google Maps & Local SEO",
    items: [
      "Google Business Profile claimed & verified",
      "Medical categories correctly set",
      "Geo-tagged clinic photos uploaded",
      "Treatment/service listings added",
      "Review generation system (QR stands)",
    ],
  },
  {
    category: "Instagram Authority",
    items: [
      "Content calendar (12–15 posts/month)",
      "Reel scripts (Hinglish/English)",
      "Clinical carousel templates",
      "Hashtag & caption strategy",
      "NMC compliance review",
    ],
  },
];
---

<PageLayout
  title="Free Growth Plan"
  description="Get a free 20-minute growth plan audit for your dermatology clinic. We'll identify the biggest gaps and show you exactly how to fill 15–30+ appointment slots every month."
>
  <!-- Hero with Stripe Gradient Mesh -->
  <section class="stripe-mesh section-lg relative overflow-hidden">
    <div class="container-main relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Left: Copy -->
        <div>
          <span class="badge-accent mb-4 inline-block">Free · No Obligation</span>
          <h1 class="font-display font-light text-ink mb-6" style="font-size: clamp(34px, 5vw, 56px); letter-spacing: -1.4px; line-height: 1.05; text-wrap: balance;">
            Your free clinic<br />
            <span class="gradient-text">growth plan.</span>
          </h1>
          <p class="text-ink-secondary font-body font-light text-base sm:text-lg leading-relaxed mb-6">
            In a free 20-minute strategy call, we'll audit your clinic's entire online presence against the 4-Pillar framework and identify exactly where you're losing patients.
          </p>
          <p class="text-ink-mute font-body font-light text-base leading-relaxed mb-8">
            You'll walk away with a clear, actionable growth plan — whether you work with DermaArc or not.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/#inquiry-form" class="btn-primary w-full sm:w-auto">
              Request Growth Plan Audit →
            </a>
          </div>
        </div>

        <!-- Right: What You Get (Featured Dark Card) -->
        <div class="card-featured p-8 sm:p-10 relative overflow-hidden" style="border: 1px solid rgba(255, 255, 255, 0.12);">
          <h3 class="font-display font-light text-white text-xl mb-6" style="letter-spacing: -0.2px;">What you'll get:</h3>
          <ul class="space-y-4">
            {[
              "Complete audit of your current online presence",
              "Gap analysis against the 4-Pillar framework",
              "Competitor landscape review (your 5–10 km area)",
              "Custom patient acquisition roadmap",
              "Projected lead volume & CPL estimates",
              "No-obligation — actionable whether you hire us or not",
            ].map((item) => (
              <li class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5" style="background-color: rgba(83, 58, 253, 0.35);">
                  <svg class="w-3.5 h-3.5 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                </div>
                <span class="text-slate-100 font-body font-light text-sm leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Audit Checklist -->
  <section class="section-lg bg-canvas-soft border-t border-hairline">
    <div class="container-main">
      <div class="text-center mb-16">
        <p class="eyebrow text-ink-mute mb-3">The 4-Pillar audit</p>
        <h2 class="font-display font-light text-ink" style="font-size: clamp(28px, 4vw, 44px); letter-spacing: -0.96px; line-height: 1.15;">
          What we check.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {auditChecklist.map((section) => (
          <div class="card p-6 sm:p-8">
            <h3 class="font-display font-light text-ink text-lg mb-4" style="letter-spacing: -0.2px;">{section.category}</h3>
            <ul class="space-y-3">
              {section.items.map((item) => (
                <li class="flex items-start gap-3">
                  <div class="w-4 h-4 rounded-full border border-primary shrink-0 mt-0.5 flex items-center justify-center">
                    <div class="w-1.5 h-1.5 rounded-full bg-primary"></div>
                  </div>
                  <span class="text-ink-secondary font-body font-light text-sm">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ROICalculator />

  <PricingSection />
  <CTASection />
</PageLayout>
